val G = [
    gold    = 0,
    level   = 1,
    party   = ["swordsman", "wizard", "swordsman", "wizard"],
    rerolls = 3,
]

val PAD = 0.03
val POPUP_PAD = 0.1
val LINE_H = 0.04

task Popup(lines) {
    val parsed = []
    var maxWidth = 0

    loop i, line in lines {
        val runs = ParseRichText(line)
        val positions, width = MeasureRuns(runs, LINE_H)
        set parsed@i = [ runs=runs, positions=positions, width=width ]
        if width > maxWidth {
            set maxWidth = width
        }
    }

    val totalHeight = #lines * LINE_H

    ;; calculate full rect to cover
    val fullRect = [ "%",
        x = 0.5, y = 0.5,
        w = maxWidth / (1 - POPUP_PAD),
        h = totalHeight / (1 - POPUP_PAD),
    ]

    pin spring = spawn Spring(1.1)
    emit @spring :start

    ;; TODO: popup layer may be required to draw it on top
    loop on :draw {
        val r = fullRect ++ [
            w = fullRect.w * spring.pub.scale,
            h = fullRect.h * spring.pub.scale,
        ]

        pico.set.pencil [ color=COLORS.idle.bg ]
        pico.output.draw.rect(r)

        val blockTop = r.y - ((totalHeight * spring.pub.scale) / 2)

        loop i, entry in parsed {
            val rowY = blockTop + (((i - 1) + 0.5) * LINE_H * spring.pub.scale)
            val rowStart = r.x - ((entry.width * spring.pub.scale) / 2)

            loop ri, run in entry.runs {
                val pos = entry.positions@ri
                pico.set.pencil [ color=run.color, font=FONT ]
                pico.output.draw.text(run.text, [ "%",
                    x = rowStart + ((pos.start + (pos.width / 2)) * spring.pub.scale),
                    y = rowY,
                    h = LINE_H * (1 - POPUP_PAD) * spring.pub.scale,
                ])
            }
        }
    }

    await(false)
}

val task CharacterIcon (id, rect, world, character, number, showName) {
    val charColorGroup = CHARACTERS@character.color
    val charColors = COLORS@charColorGroup

    ;; larger hover box for popup detection
    val hover = [
        "%", anchor=world.anchor,
        x=world.x, y=world.y, h=world.h*1.2, w=world.w*1.2,
    ]

    pin obj = spawn Object(nil, hover, 1)

    do {
        pico.set.layer(id)

        pico.set.pencil [ color=charColors.base ]
        pico.output.draw.rect(rect)

        pico.set.pencil [ color=charColors.text, font=FONT ]
        pico.output.draw.text(tostring(number)) <- [
            "%", x=rect.x, y=rect.y, h=rect.h*0.9,
        ]

        if showName {
            pico.set.pencil [ color=charColors.base, font=FONT ]
            pico.output.draw.text(character) <- [
                "%", x=rect.x, y=(rect.y + rect.h), h=rect.h*0.9,
            ]
        }

        pico.set.layer(:world)
    }

    ;; TODO, cost calculation of unit
    val cost = 0;
        
    val headerColor, labelColor, effectText =
        if (G.level == 3)
            => ("yellow", "idle",  CHARACTERS@character.effect_description)
            => ("hover",  "hover", CHARACTERS@character.effect_description)

    val classList = CHARACTERS@character.classes
    var formattedClasses = []

    loop i, c in classList {
        val classColor = (
            if (CLASSES@c.color == nil) => "idle" => CLASSES@c.color
        )
        set formattedClasses = formattedClasses ++ ["[" ++ classColor ++ "]" ++ c]
    }

    val popupText = [ s1, s2, s3, s4, s5 ] where {
        s1 = "[" ++ CHARACTERS@character.color ++ "]" ++
             CHARACTERS@character.name ++ "[idle] - cost: [gold]" ++ cost
        s2 = "[idle]Classes: " ++ table.concat(formattedClasses, "[idle], ")
        s3 = CHARACTERS@character.description
        s4 = "[" ++ headerColor ++ "]" ++
             "Lv.3 [" ++ labelColor ++ "]" ++
             "Effect - " ++ CHARACTERS@character.effect_name
        s5 = effectText
    }

    loop {
        await :o.over.on [obj=obj.pub]
        spawn Popup(popupText)
        await :o.over.off [obj=obj.pub]
    }
}

val task PartyColumnCell(index, layerRect, character, slotHeight, group) {
    set pub = [ slot = index ]
    val cellId = :party_column_ ++ index

    val rect = ["%",
        x=0.5, y=pub.slot * slotHeight,
        w=0.03, h=0.03 * ASPECT_RATIO * (layerRect.w / layerRect.h),
    ]

    val worldRect = [ "%",
        x = (layerRect.x - (layerRect.w / 2)) + (rect.x * layerRect.w),
        y = layerRect.y + (rect.y * layerRect.h),
        w = rect.w * layerRect.w,
        h = rect.h * layerRect.h,
    ]

    pin obj = spawn Object(cellId, worldRect, 1)

    par {
        loop {
            set rect.y = pub.slot * slotHeight
            set worldRect.x = (layerRect.x - (layerRect.w / 2)) + (rect.x * layerRect.w)
            set worldRect.y = layerRect.y + (rect.y * layerRect.h)

            spawn CharacterIcon(:party_column, rect, worldRect, character, 1, false)

            await(:slot_changed)
        }
    } with {
        var m = ["%", x=0, y=0]
    
        loop on :o.click.dn [id=cellId] {                
            await :mouse.button.up

            val mouse = pico.get.mouse(m)
            val localY = (mouse.y - layerRect.y) / layerRect.h
            var targetSlot = math.floor((localY / slotHeight) + 0.5)
            set targetSlot = math.min(targetSlot, #(G.party))
            set targetSlot = math.max(targetSlot, 1)
            
            print("Moved "++pub.slot++" To "++targetSlot)
            
            if targetSlot != pub.slot {
                
                emit @(:global) (:reorder [from=pub.slot, to=targetSlot])
                
                set pub.slot = targetSlot
            }
 
        }
    } with {
        loop {
            val r = await(:reorder)

            val newSlot = ifs {
                r.from == pub.slot => r.to
                (r.to <= pub.slot) && (pub.slot < r.from) => pub.slot + 1
                (r.from < pub.slot) && (pub.slot <= r.to) => pub.slot - 1
                else => pub.slot
            }

            if newSlot != pub.slot {
                set pub = [ slot = newSlot ]
                emit(:slot_changed)
            }
        }
    }
}

val func class_banners (id, rect, character) {
    val charClasses = CHARACTERS@character.classes
    val charClassesCount = #charClasses
    val cardAspectRatio = rect.w / rect.h

    pico.set.layer(id)

    ;; TODO: color the class icon to COLORS.hover.fg
    loop i, class in charClasses {
        ;; center + (divided_x * spacing)
        val x = 0.5 + ((i - ((charClassesCount + 1)/2)) * 0.23)

        pico.set.pencil [ color=COLORS.idle.bg, font=FONT ]
        pico.output.draw.rect([
            "%", x=x, y=0.56,
            w=0.2, h=0.33 * cardAspectRatio * ASPECT_RATIO,
        ])

        pico.set.pencil [ color=COLORS.idle.fg, font=FONT ]
        pico.output.draw.image("../assets/images/" ++ class ++ ".png") <- [
            "%", x=x, y=0.56,
            w=0.17,
            h=0.17 * CLASS_ICON_ASPECT_RATIO * cardAspectRatio * ASPECT_RATIO,
        ]
    }

    pico.set.layer(:world)
}

val task Card (id, x, y, character) {
    val dim = [ "%", w=0.16, h=0.2*ASPECT_RATIO ]
    val rat = dim.w / dim.h
    val rct = [ "%", x=x, y=y, w=dim.w, h=dim.h ]
    pin obj = spawn Object(id, rct, 1)
    pin spr = spawn Spring(1.3)

    pico.layer.empty('~', nil, id, false, dim)

    spawn {
        val bg = pico.color.alpha(COLORS.hover.bg, 15)
        loop on :draw {
            set rct.w = dim.w * spr.pub.scale
            set rct.h = dim.h * spr.pub.scale
            if obj.pub.over {
                ;;pico.set.pencil [ color=bg ]
                ;;pico.output.draw.rect(rct)
            }
            pico.output.draw.layer(id, rct)
        }
    }

    spawn CharacterIcon(id, r, world, character, 1, true) where {
        r = [ "%", x=0.5, y=0.2, h=(0.2 * rat * ASPECT_RATIO), w=0.2 ]
        world = rct ++ [
            x = rct.x,
            y = rct.y - (0.3 * rct.h),
            h = 0.2 * rat * ASPECT_RATIO * rct.h,
            w = 0.2 * rct.w,
        ]
    }
    class_banners(id, rct, character)

    spawn {
        loop {
            if obj.pub.over {
                emit @spr :start
                pico.output.sound(SOUNDS.hover)
            }
            await :o.over.on [id=id]
        }
    }

    await :o.click.dn [id=id]
    pico.output.sound(SOUNDS.pop)
    id
}

val func roll_cards () {
    ;; TODO: port tier_weights / weighted_pick from the Lua roll logic
    return([
        "swordsman",
        "wizard",
        "swordsman",
    ])
}

val task BuyScreen () {
    spawn Button(:go, 2, rect, "Go!") where {
        rect = ["%", x=0.88, y=0.9, h=0.1]
    }

    ;;spawn @ui RerollButton(:reroll, 3, rect) where {
    ;;    rect = ["%", x=0.28, y=0.06, h=0.07]
    ;;}

    spawn {
        loop {
            spawn RichTextButton(:reroll, 1, rct, lbl) where {
                rct = ["%", x=0.28, y=0.06, h=0.07]
                lbl = "[idle]Rerolls: [gold]" ++ G.rerolls
            }

            pin cs = tasks()
            loop i, character in roll_cards() {
                spawn @cs Card(:card_ ++ i, i * 0.16, 0.3, character)
            }

            await :o.click.dn [id=:reroll] until (G.rerolls > 0)
            set G.rerolls = (G.rerolls - 1)
        }
    }

    par:any {
        await :o.click.dn [id=:go]
        true
    } with {
        await :key.dn [key=:Escape]
        false
    }

    spawn {
        loop {
            pico.push()
            defer { pico.pop() }
            
            pin pt = tasks()
            
            val columnLayerRect = ["%", x=0.95, y=0.1, w=1, h=0.8, anchor="N"]
            val colAspectRatio = columnLayerRect.w/columnLayerRect.h
            
            pico.layer.empty(:world, :party_column, false, columnLayerRect)
            
            loop i, character in G.party {
                spawn @pt PartyColumnCell(i, columnLayerRect, character, 0.08, pt)
            }
            await(false)
        }
    }
}

task Battle() {
    print("Battle Started!")
    
    watching 5s {
        loop on :draw{
            ;; battle arena
            pico.set.pencil [ color=COLORS.idle.bg, font=FONT ]
            pico.output.draw.rect([
                "%", x=0.5, y=0.5,
                w=(0.8), h=(0.4 * ASPECT_RATIO),
            ])
        }
    }
}

task Arena() {
    loop {
        val ok = await BuyScreen()
        while(ok)
        await Transition([x=0.9,y=0.9], Battle)
    }
}

Arena
