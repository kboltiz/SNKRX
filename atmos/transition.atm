val SPEED = 5/1s
val OUT_DELAY = 1s

;; so the circle covers the entire screen at peak
func cover_radius (x, y) {
    val d1 = math.sqrt((x*x) + (y*y))
    val d2 = math.sqrt(((1-x)*(1-x)) + (y*y))
    val d3 = math.sqrt((x*x) + ((1-y)*(1-y)))
    val d4 = math.sqrt(((1-x)*(1-x)) + ((1-y)*(1-y)))
    math.max(d1, d2, d3, d4) + 0.1
}

task Transition (msg, pos, Next, ...) {
    val args = [ ... ]
    pico.push()
    defer {
        pico.pop()
    }

    var pct = 0.0 ;; 0->1, delay, 1->0
    spawn {
        ;; 1 | 0 -> 1
        watching while pct<1 {
            loop us on :clock {
                set pct = (pct + (SPEED * us))
            }
        }
        emit :1

        ;; 2 | load time
        await(OUT_DELAY)
        emit :2

        ;; 3 | 1 -> 0 (with Next already running)
        watching while pct>0 {
            loop us on :clock {
                set pct = (pct - (SPEED * us))
            }
        }
        emit :3
    }

    par:any {
        ;; freeze and show old until oval covers it
        pico.layer.screenshot [ mode='~', key=:transition, sup=:window ]
        watching :1 {
            loop on :draw {
                pico.output.draw.layer(:transition) <- [
                    '%', x=0.5, y=0.5, w=1, h=1
                ]
            }
        }
        await :2
        await Next(table.unpack(args))
    } with {
        watching :3 {
            par {
                ;; draw oval with current pct
                val cover = cover_radius(pos.x, pos.y)
                loop on :draw {
                    pico.set.pencil [ color=COLORS.hover.bg, font=FONT ]
                    pico.output.draw.oval [
                        '%', x=pos.x, y=pos.y,
                        w = pct * cover * 2,
                        h = pct * cover * 2 * ASPECT_RATIO,
                    ]
                }
            } with {
                loop on :draw {
                    pico.set.pencil [ color=COLORS.idle.bg, font=FONT ]
                    pico.output.draw.text(msg, ['%', x=0.5, y=0.5, h=0.05])
                }
            }
        }
        await(false)
    }
}
