val SPEED = 5/1s
val OUT_DELAY = 1s

task Transition (Next, ...) {
    val args = [ ... ]
    pico.push()
    defer {
        pico.pop()
    }

    var pct = 0.0 ;; 0->1, delay, 1->0
    spawn {
        ;; 1 | 0 -> 1
        watching while pct<1 {
            loop us on :clock {
                set pct = (pct + (SPEED * us))
            }
        }
        emit :1

        ;; 2 | load time
        await(OUT_DELAY)
        emit :2

        ;; 3 | 1 -> 0 (with Next already running)
        watching while pct>0 {
            loop us on :clock {
                set pct = (pct - (SPEED * us))
            }
        }
        emit :3
    }

    par:any {
        ;; freeze and show old until oval covers it
        pico.layer.screenshot(nil, :transition, :window)
        watching :1 {
            loop on :draw {
                pico.output.draw.layer(:transition) <- [
                    "%", x=0.5, y=0.5, w=1, h=1
                ]
            }
        }
        await :2
        await Next(table.unpack(args))
    } with {
        watching :3 {
            par {
                ;; draw oval with current pct
                val sqrt = math.sqrt(2)
                loop on :draw {
                    pico.set.pencil [ color=COLORS.hover.bg, font=FONT ]
                    pico.output.draw.oval [
                        "%", x=0.5, y=0.5,
                        w = pct * sqrt,
                        h = pct * sqrt * ASPECT_RATIO,
                    ]
                }
            } with {
                loop on :draw {
                    pico.set.pencil [ color=COLORS.idle.bg, font=FONT ]
                    pico.output.draw.text("Loading...", [
                        "%", x=0.5, y=0.5,
                        h=0.05, anchor="C"
                    ])
                }
            }
        }
        await(false)
    }
}
