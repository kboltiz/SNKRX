val M = []

;; PATTERN #5 : Signaling Mechanisms : action :start
;;  - outer object controls spring through :start
;; PATTERN #1 : Finite State Machines : idle -> running -> idle
;;  - waits initial start, runs to completion
;;  - restarts when requested
;;  - uses await/watching/await

;; TODO: document vars, any possible simplification?
task M.Simple (size) {
    set pub = [ scale=1.0 ]
    val k = 400
    val d = 15
    var v = 1

    await :start            ;; wait first :start
    
    loop {
        val target = 1
        set pub.scale = size
        watching :start {
            loop {
                val us = await :clock
                val dt = us/1s;
                val a  = (-k * (pub.scale - target)) - (d * v)
                set v  = v + (a * dt);
                set pub.scale  = pub.scale + (v * dt)
                until (math.abs(pub.scale-target) < 0.0001)
            }
            await(false)    ;; wait for next :start
        }
    }
}

task M.Object (me, size) {
    pin spring = spawn M.Simple(size)
    set me.pub.spring = spring.pub
    set me.pub.spring.rect = [] ++ me.pub.rect

    par {
        loop {
            if me.pub.over {
                emit @spring :start
                pico.output.sound(SOUNDS.hover)
            }
            await :o.over.on [me=me]
        }
    } with {
        loop on :clock {
            set me.pub.spring.rect.w = me.pub.rect.w * spring.pub.scale
            set me.pub.spring.rect.h = me.pub.rect.h * spring.pub.scale
        }
    }
}

M
