
;; TODO: document vars, any possible simplification?
task (size) {
    set pub = [ scale=1.0 ]
    val k = 400
    val d = 15
    var v = 1

    await :start            ;; wait first :start
    
    loop {
        val target = 1
        set pub.scale = size
        watching :start {
            loop {
                val us = await :clock
                val dt = us/1s;
                val a  = (-k * (pub.scale - target)) - (d * v)
                set v  = v + (a * dt);
                set pub.scale  = pub.scale + (v * dt)
                until (math.abs(pub.scale-target) < 0.0001)
            }
            await(false)    ;; wait for next :start
        }
    }
}
