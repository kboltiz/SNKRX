require "button"
require "transition"

val h = 0.08

;; ToggleButton, RangeButton
;; PATTERN #3 : Dispatching Hierarchies: Outer -> Inner button
;;  - outer dispatches :draw,:mouse to inner automatically
;; PATTERN #4 : Lifespan Hierarchies : Outer > Inner
;;  - outer loop owns spawned Button, which restarts on each iteration
;; PATTERN #5 : Signaling Mechanisms : Inner -> Outer button
;;  - clicks in inner button signals outer button

;; Toggle / Range:
;; They never terminate and handle their effects internally.
;; We re-create their internal Buttons in a loop bc they change labels.

val task ToggleButton(id, rect, property) {
    loop {
        val cur = SETTINGS@property;
        spawn Button(id, 1, rect, property ++ ": " ++ (if cur => "yes" => "no"))
        await :o.click.dn [id=id]
        set SETTINGS@property = !cur
    }
}

val task RangeButton(id, rect, property) {
    loop {
        val cur,max = table.unpack(SETTINGS@property)
        spawn Button(id, 1, rect, property ++ ": " ++ cur)
        await :o.click.dn [id=id]
        set SETTINGS@property = [(cur + 1) % (max + 1), max]
    }
}

;; Options Menu
;; PATTERN #3 : Dispatching Hierarchies: Menu -> Buttons
;;  - menu dispatches :draw,:mouse to buttons automatically
;; PATTERN #4 : Lifespan Hierarchies : Menu > Buttons
;;  - menu owns spawned Buttons, which are aborted on termination
;; PATTERN #5 : Signaling Mechanisms : Buttons -> Menu
;;  - button clicks :quit/:close signal menu to terminate

val task Options() {
    print("Options Opened")

    ;; overlay translucent background
    spawn {
        val clr = pico.color.alpha(COLORS.idle.bg, 200) ;; TODO: check if value/effect are correct
        loop on :draw {
            pico.set.pencil [ color=clr ]
            pico.output.draw.rect [
                "%", x=0.5, y=0.5, w=1, h=1, anchor="C"
            ]
        }
    }

    ;; TODO text-dependent center alignment of option buttons
    spawn Button(:opts_quit, 1, rect, "quit") where {
        rect = ["%", x=0.5, y=0.6, h=h]
    }
    spawn ToggleButton(:shake, rect, "screen shake") where {
        rect = ["%", x=0.5, y=0.4, h=h]
    }
    spawn RangeButton(:music, rect, "music volume") where {
        rect = ["%", x=0.5, y=0.5, h=h]
    }
    spawn Button(:close, 1, rect, "main menu") where {
        rect = ["%", x=0.5, y=0.2, h=h]
    }

    ;; only :close / :quit escape
    ;; other buttons have internal effects, we ignore them here
    loop b on :o.click.dn {
        match b.id {
            :close => break(false)
            :opts_quit  => break(true)
        }
    }
}

val x = 0.01

;; Main Menu
;; PATTERN #3 : Dispatching Hierarchies: Menu -> Buttons
;;  - menu dispatches :draw,:mouse to buttons automatically
;; PATTERN #4 : Lifespan Hierarchies : Menu > Buttons
;;  - menu owns spawned Buttons, which are aborted on termination
;; PATTERN #5 : Signaling Mechanisms : Buttons -> Menu
;;  - button clicks signal menu actions
;; PATTERN #6 : Pausing : TODO

task Menu () {
    ;; butons remain alive
    pin bs = tasks(3)
    spawn @bs Button(:arena, 2, rect, "arena run") where {
        rect = ["%", x=x, y=0.5, h=h, anchor='W']
    }
    spawn @bs Button(:options, 2, rect, "options") where {
        rect = ["%", x=x, y=0.6, h=h, anchor='W']
    }
    spawn @bs Button(:quit, 2, rect, "quit") where {
        rect = ["%", x=x, y=0.7, h=h, anchor='W']
    }

    ;; we react to each click
    loop b on :o.click.dn {
        until (b.id != :options, b.id)  ;; escape except on option
        toggle bs(false) with :draw
        val quit = await Options()      ;; overlay Option with paused `bs`
        until (quit, :quit)             ;; Option may quit directly
        toggle bs(true)
    }
}

Menu
