;; PATTERN #1 : Finite State Machines : over,left,right,middle
;;  - awaits in loop bookkeep internal state
;; PATTERN #3 : Dispatching Hierarchies : Object -> target
;;  - Object dispatches :over,:click to target listeners and their children

task Object (me, target) {
    set me.pub = me.pub ++ [
        ;; id, rect, layer          ;; from outer `me`
        over   = over,              ;; if mouse over rect
        left   = over && m.left,    ;; if mouse clicked over rect
        right  = over && m.right,
        middle = over && m.middle,
    ] where {
        m = pico.get.mouse('%')
        over = pico.vs.pos.rect(m, me.pub.layer, me.pub.rect)
    }

    par {
        ;; motion: track `over`, emit on/off on change
        val tags = [
            @(true)  = :o.over.on,
            @(false) = :o.over.off,
        ]
        loop e on :mouse.motion {
            val over = pico.vs.pos.rect(:window, e, me.pub.layer, me.pub.rect)
            if over != me.pub.over {
                set me.pub.over = over
                emit @(target) [tag=tags@over, me=me, id=me.pub.id]
            }
        }
    } with {
        ;; button: mirror buttons + emit dn/up while over
        val tags = [
            @(:mouse.button.dn) = :o.click.dn,
            @(:mouse.button.up) = :o.click.up,
        ]
        loop e on :mouse.button until me.pub.over {
            set me.pub.left   = e.left
            set me.pub.right  = e.right
            set me.pub.middle = e.middle
            emit @(target) [tag=tags@(e.tag), me=me, id=me.pub.id]
        }
    }
}
