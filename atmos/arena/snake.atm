val Abilities = require "arena.abilities"

val SPACING = 0.03
val TRAIL_MAX = 256
val HEAD_SPEED = 0.4
val TURN_RATE = 4
val UNIT_SIZE = 0.03

val MIN_BOUNCE_ANGLE = math.pi / 6   ;; 30 degrees off the wall (to prevent wall hugging)

val func clamp_away_from_wall(r, isVertical) {
    var result = r
    if isVertical {
        ;; angle measured from the vertical (wall-parallel) axis
        val fromVertical = angle_diff(math.pi/2, r)
        if math.abs(fromVertical) < MIN_BOUNCE_ANGLE {
            val sign = ((fromVertical >= 0) && 1) || -1
            set result = (math.pi/2) - (sign * MIN_BOUNCE_ANGLE)
        } else {
            val fromNegVertical = angle_diff(-math.pi/2, r)
            if math.abs(fromNegVertical) < MIN_BOUNCE_ANGLE {
                val sign = ((fromNegVertical >= 0) && 1) || -1
                set result = (-math.pi/2) - (sign * MIN_BOUNCE_ANGLE)
            }
        }
    } else {
        val fromHorizontal = angle_diff(0, r)
        if math.abs(fromHorizontal) < MIN_BOUNCE_ANGLE {
            val sign = ((fromHorizontal >= 0) && 1) || -1
            set result = sign * MIN_BOUNCE_ANGLE
        } else {
            val fromPi = angle_diff(math.pi, r)
            if math.abs(fromPi) < MIN_BOUNCE_ANGLE {
                val sign = ((fromPi >= 0) && 1) || -1
                set result = math.pi - (sign * MIN_BOUNCE_ANGLE)
            }
        }
    }
    return(result)
}

;; single backward pass over the trail, satisfying every follower's
;; target distance in one walk instead of one walk per follower
val func sample_all_trail(trail, followerCount) {
    val results = []
    var distanceSum = 0
    var i = #trail
    var prev = trail@i
    var nextIdx = 1

    loop {
        set i = (i - 1)
        until(i < 1)

        val point = trail@i
        val dx = (point.x - prev.x)
        val dy = ((point.y - prev.y) / ASPECT_RATIO)
        set distanceSum = (distanceSum + math.sqrt((dx*dx) + (dy*dy)))

        loop {
            until((nextIdx > (followerCount - 1)) || (distanceSum < (SPACING * nextIdx)))
            set results@nextIdx = point
            set nextIdx = (nextIdx + 1)
        }
        if nextIdx > (followerCount - 1) {
            return(results)
        }

        set prev = point
    }

    ;; ran out of trail before satisfying everyone: fill remainder with oldest point
    loop {
        until(nextIdx > (followerCount - 1))
        set results@nextIdx = prev
        set nextIdx = (nextIdx + 1)
    }
    return(results)
}

val func bounce(r, nx, ny) {
    var result = r
    if nx == 0 {
        set result = (2 * math.pi) - result
    }
    if ny == 0 {
        set result = math.pi - result
    }
    return(result)
}

val func enemy_in_range(range, pos) {
    loop _, t in ENEMIES {
        val dx = (t.pub.x - pos.x)
        val dy = ((t.pub.y - pos.y) / ASPECT_RATIO)
        val dist = math.sqrt((dx*dx) + (dy*dy))
        until (dist<=range, [ x=t.pub.x, y=t.pub.y ])
    }
}

val barW = 0.05

val barH = 0.03

val barGap = 0.01

val barY = 0.95

val border = 0.004

val cdH = 0.02

val cdGapY = 0.005

;; bars laid out left-to-right by spawn index
val func bar_left(index) { (0.02 + ((index - 1) * (barW + barGap))) }

;; trackW/trackH: the hollow inner area, inset from the outer
val trackW = (barW - (border * 2))

val trackH = (barH - (border * 2 * ASPECT_RATIO))

val func char_colors(character) { COLORS@(CHARACTERS@character.color) }

;; PATTERN #1 : Finite State Machines : live bars -> spent frame
;;  - outlives the unit it reports on, so it can watch it die and carry on
;;    drawing; the slot it was given never moves, which is what keeps the
;;    frame it leaves behind lined up with the bars either side of it
val task StatBars(slot, character, unit) {
    val colors = char_colors(character)
    val leftEdge = bar_left(slot)
    val trackLeft = (leftEdge + border)

    watching (unit) {

    var hp, maxHp = (100, 100)

    spawn {
        loop {
            val d = await :hp [slot=slot]
            set hp = d.hp
            set maxHp = d.max
        }
    }

    par {
        ;; healthbar
        loop on :draw {
            ;; greyed out healthbars moved to the end of statbars

            ;; outer frame
            pico.set.pencil [ color=colors.base ]
            pico.output.draw.rect [ "%", x=leftEdge, y=barY, w=barW, h=barH, anchor="W" ]

            ;; hollow track
            pico.set.pencil [ color=:black ]
            pico.output.draw.rect [ "%", x=trackLeft, y=barY, w=trackW, h=trackH, anchor="W" ]

            val fillWidth = (trackW * (hp / maxHp))
            ;; inner meter
            ;; edgecase, rect seems to inflate at exactly width = 0
            if fillWidth > 0 {
                pico.set.pencil [ color=colors.base ]
                pico.output.draw.rect [ "%", x=trackLeft, y=barY, w=fillWidth, h=trackH, anchor="W" ]
            }
        }
    } with {
        ;; cooldown bar sits just below the hp bar
        val cdY = (barY + (barH / 2) + cdGapY + (cdH / 2))
        val cdTrackH = (cdH - (border * 2 * ASPECT_RATIO))

        ;; cooldown bar: full means ready, so it stands full from the start,
        ;; empties on a cast and fills back up over the interval
        loop {
            val data = watching :ability_fired [slot=slot] {
                loop on :draw {
                    pico.set.pencil [ color=colors.base ]
                    pico.output.draw.rect [ "%",
                        x=trackLeft, y=cdY, w=trackW, h=cdTrackH, anchor="W",
                    ]
                }
            }

            var elapsed = 0

            par :any {
                ;; edgecase, rect seems to inflate at exactly width = 0
                loop on :draw {
                    val cdFillW = (trackW * math.min((elapsed / data.interval), 1))
                    if cdFillW > 0 {
                        pico.set.pencil [ color=colors.base ]
                        pico.output.draw.rect [ "%", x=trackLeft, y=cdY, w=cdFillW, h=cdTrackH, anchor="W" ]
                    }
                }
            } with {
                loop {
                    val us = await :clock
                    set elapsed = (elapsed + us)
                    until (elapsed >= data.interval)
                }
            }
        }
    }

    }

    ;; the unit is gone: its slot keeps the spent frame for the rest of the run
    loop on :draw {
        pico.set.pencil [ color=COLORS.idle.bg ]
        pico.output.draw.rect [ "%", x=leftEdge, y=barY, w=barW, h=barH, anchor="W" ]
        pico.set.pencil [ color=:black ]
        pico.output.draw.rect [ "%", x=trackLeft, y=barY, w=trackW, h=trackH, anchor="W" ]
    }
}

;; slot is where this unit's bars sit and never moves, while index is its
;; place in the snake, which moves up as the units ahead of it die
val task SnakeUnit(index, character, trail, positions, party, pace) {
    val slot = index
    val colors = char_colors(character)
    var pos = [ x=SNAKE_POS.x, y=SNAKE_POS.y, r=0 ]
    ;; hp shared through events instead of pub
    var hp, maxHp = (100, 100)

    ;; PATTERN #5 : Signaling Mechanisms : party pool -> unit
    ;;  - the priest heals the pool, not any unit in particular, so each
    ;;    one applies the fraction to its own maximum and tells its bar
    spawn {
        loop {
            val h = await :heal
            set hp = math.min((hp + math.floor(maxHp * h.frac)), maxHp)
            emit @2 :hp [ slot=slot, hp=hp, max=maxHp ]
        }
    }

    ;; movement, no exit condition of its own;
    ;; cleaned up automatically on task cleanup (PATTERN #4)
    spawn {
        ;; follower until every unit ahead is gone (PATTERN #1)
        if index > 1 {
            par :any {
                ;; a unit dies with its index: anything ahead of this one
                ;; moves it a place forward
                loop i on :any party {
                    if (i < index) {
                        set index = (index - 1)
                    }
                    until (index == 1)
                }
            } with {
                loop on :clock {
                    ;; the head samples one point per follower every tick,
                    ;; so this slot is always filled by the time it is read
                    val s = positions@(index - 1)
                    assert(s)
                    set pos.x = s.x
                    set pos.y = s.y
                    set pos.r = s.r
                }
            }
        }

        ;; index is 1 from here on: this unit inherited the head
        loop {
            val us = await :clock
            ;; pace.n is 1 in play and eases to 0 when the arena clears,
            ;; which slows the turn and the step together
            val dt = ((us/1s) * pace.n);

            val m = pico.get.mouse('%')
            val dxVisual = (m.x - pos.x)
            val dyVisual = ((m.y - pos.y) / ASPECT_RATIO)
            val desired = math.atan(dyVisual, dxVisual)

            val diff = angle_diff(pos.r, desired)
            val maxTurn = (TURN_RATE * dt)
            val turn = math.max(math.min(diff, maxTurn), -maxTurn)

            set pos.r = (pos.r + turn)

            ;; direction without collision
            var nextX = (pos.x + (math.cos(pos.r) * HEAD_SPEED * dt))
            var nextY = (pos.y + (math.sin(pos.r) * HEAD_SPEED * dt * ASPECT_RATIO))

            val hitVertical = (nextX < ARENA_LEFT) || (nextX > ARENA_RIGHT)
            val hitHorizontal = (nextY < ARENA_TOP) || (nextY > ARENA_BOTTOM)

            ;; corner hit
            if hitVertical && hitHorizontal {
                set pos.r = (pos.r + math.pi)
            } else {
                if hitVertical {
                    set pos.r = bounce(pos.r, 1, 0)
                    set pos.r = clamp_away_from_wall(pos.r, true)
                }
                if hitHorizontal {
                    set pos.r = bounce(pos.r, 0, 1)
                    set pos.r = clamp_away_from_wall(pos.r, false)
                }
            }
                
            if (hitVertical || hitHorizontal) {
                emit(:flash_unit)
            }

            set nextX = math.max(math.min(nextX, ARENA_RIGHT), ARENA_LEFT)
            set nextY = math.max(math.min(nextY, ARENA_BOTTOM), ARENA_TOP)

            set pos.x = nextX
            set pos.y = nextY

            set SNAKE_POS.x = pos.x
            set SNAKE_POS.y = pos.y

            set trail@+ = [ x=pos.x, y=pos.y, r=pos.r ]
            if (#trail > TRAIL_MAX) {
                table.remove(trail, 1)
            }

            val sampled = sample_all_trail(trail, #G.party)
            loop fi, s in sampled {
                set positions@fi = s
            }
        }
    }

    ;; flash on hit, spring pop, spawned as a child same as movement
    ;; the unit is drawn in one place; the state machine below only says
    ;; what colour and scale to draw it at (PATTERN #1)
    spawn {
        var clr = colors.base
        var scale = 1

        spawn {
            loop on :draw {
                pico.set.pencil [ color=clr ]
                pico.output.draw.oval [ "%",
                    x=pos.x, y=pos.y,
                    w=(UNIT_SIZE * scale),
                    h=(UNIT_SIZE * ASPECT_RATIO * scale),
                ]
            }
        }

        loop {
            await :flash_unit

            pin spring = spawn Spring.Simple(1.8)
            emit @spring :start

            set clr = :white
            watching (0.15*1s) {
                loop on :clock {
                    set scale = spring.pub.scale
                }
            }
            set clr = colors.base
            set scale = 1
        }
    }

    ;; ability loop
    spawn {
        val ability = Abilities@character
        if !ability {
            return()    ;; TODO: atmos has no simple way to spawn only on condition
        }

        ;; abilities can either yield till
        ;; completion OR snake unit existence

        ;; Sentry unit's turrets (that stays alive
        ;; beyond one ability instance) is now possible

        pin castPool = tasks()
        
        ;; not return(): this block is transparent, so a return would
        ;; terminate SnakeUnit itself
        ;; cooldown before checking again (TODO: ok on startup?)
        loop on (ability.interval) {
            ;; a healer has nothing to aim at, so it does not stand around
            ;; waiting for an enemy the way the attackers do
            var enemy_pos = nil
            if ability.needs_target {
                set enemy_pos = loop on :clock {
                    until (enemy_in_range(ability.range, pos))
                }
            }

            ;; the party comes along, since an ability may address it
            spawn @castPool ability.caster(pos, enemy_pos, party)
            emit :flash_unit
            ;; @2 is Snake: 0 is this unit, 1 the party pool it sits in.
            ;; the enclosing spawn block is not a level of its own
            emit @2 :ability_fired [ slot=slot, interval=ability.interval ]
        }
    }

    ;; enemy collision
    val TOUCH_RADIUS = ((UNIT_SIZE/2) + (0.025/2))
    val TOUCH_KNOCKBACK = 0.05
    val TOUCH_DMG = 5
    val SHOT_RADIUS = ((UNIT_SIZE/2) + 0.01)

    loop on :clock {
        var taken = 0

        loop _, t in ENEMIES {
            val dx = (t.pub.x - pos.x)
            val dy = ((t.pub.y - pos.y) / ASPECT_RATIO)
            if math.sqrt((dx*dx) + (dy*dy)) < TOUCH_RADIUS {
                ;; dmg=0: running into a unit only shoves the enemy back,
                ;; the unit is the one that takes the damage
                emit @t :hit [
                    dmg=0,
                    srcX=pos.x, srcY=pos.y,
                    knockback=TOUCH_KNOCKBACK,
                ]
                set taken = (taken + TOUCH_DMG)
            }
        }

        ;; a shot carries its own damage and ends on whoever soaks it up
        loop _, s in SHOTS {
            val dx = (s.pub.x - pos.x)
            val dy = ((s.pub.y - pos.y) / ASPECT_RATIO)
            if math.sqrt((dx*dx) + (dy*dy)) < SHOT_RADIUS {
                emit @s :absorbed
                set taken = (taken + s.pub.dmg)
            }
        }

        if taken > 0 {
            emit :flash_unit
            set hp = math.max(hp - taken, 0)
            ;; up to Snake and back down into the bars pool (see the cast above)
            emit @2 :hp [ slot=slot, hp=hp, max=maxHp ]

            if hp <= 0 {
                table.remove(G.party, index)
                ;; dies with its index, which is what tells Snake which
                ;; bar slot it vacated
                return(index)
            }
        }
    }
}

val task Snake(pace) {
    var trail = [[ x=0.5, y=0.5, r=0 ]]
    val positions = []

    ;; the bars sit beside the units rather than inside them: each one
    ;; watches its unit die and then keeps its slot, so nothing here
    ;; bookkeeps the dead. The units reach them by emitting up to here,
    ;; so no reference to this pool has to travel down with them
    pin bars = tasks()

    pin party = tasks()
    loop i, character in G.party {
        print("Spawning "++character++ " " ++ i)
        spawn @party SnakeUnit(i, character, trail, positions, party, pace)
    }

    loop i, unit in party {
        spawn @bars StatBars(i, G.party@i, unit)
    }

    ;; the party pool empties when the last unit is down
    await :all party
}

Snake
