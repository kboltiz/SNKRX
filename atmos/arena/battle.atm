val Seeker = require "arena.enemies"
val Abilities = require "arena.abilities"

val SPACING = 0.03
val TRAIL_MAX = 256
val HEAD_SPEED = 0.4
val TURN_RATE = 4
val UNIT_SIZE = 0.03

val ARENA_W = 0.8
val ARENA_H = 0.4 * ASPECT_RATIO
val ARENA_LEFT = 0.5 - (ARENA_W / 2)
val ARENA_RIGHT = 0.5 + (ARENA_W / 2)
val ARENA_TOP = 0.5 - (ARENA_H / 2)
val ARENA_BOTTOM = 0.5 + (ARENA_H / 2)

val MIN_BOUNCE_ANGLE = math.pi / 6   ;; 30 degrees off the wall (to prevent wall hugging)

;; waves per level, ported from SNKRX's level_to_max_waves
val LEVEL_WAVES = [
    2, 3, 4,
    3, 4, 4, 5,
    5, 5, 5, 5, 7,
    6, 6, 7, 7, 8, 10,
    8, 8, 10, 12, 14, 16, 25,
]

val WAVE_DELAY = 1s           ;; breather between clearing a wave and the next spawn
val CLUSTER_RADIUS = 0.08     ;; how tightly a horde packs around its spawn point
;; keeps a horde off the snake's face; the arena is thin, so a larger
;; clearance leaves only its far ends available
val CENTRE_MIN_DIST = 0.15
val CENTRE_TRIES = 16         ;; bounded, so a cornered snake can still be spawned around

val WAVE_TEXT_X = 0.03        ;; top-left corner, above the arena
val WAVE_TEXT_Y = 0.06
val WAVE_TEXT_H = 0.04

val func level_waves(level) { LEVEL_WAVES@(math.min(level, #LEVEL_WAVES)) }
;; enemies in a wave, ported from SNKRX: 8 + (wave-1)*2
val func wave_enemies(wave) { (8 + ((wave - 1) * 2)) }

val func clamp_away_from_wall(r, isVertical) {
    var result = r
    if isVertical {
        ;; angle measured from the vertical (wall-parallel) axis
        val fromVertical = angle_diff(math.pi/2, r)
        if math.abs(fromVertical) < MIN_BOUNCE_ANGLE {
            val sign = ((fromVertical >= 0) && 1) || -1
            set result = (math.pi/2) - (sign * MIN_BOUNCE_ANGLE)
        } else {
            val fromNegVertical = angle_diff(-math.pi/2, r)
            if math.abs(fromNegVertical) < MIN_BOUNCE_ANGLE {
                val sign = ((fromNegVertical >= 0) && 1) || -1
                set result = (-math.pi/2) - (sign * MIN_BOUNCE_ANGLE)
            }
        }
    } else {
        val fromHorizontal = angle_diff(0, r)
        if math.abs(fromHorizontal) < MIN_BOUNCE_ANGLE {
            val sign = ((fromHorizontal >= 0) && 1) || -1
            set result = sign * MIN_BOUNCE_ANGLE
        } else {
            val fromPi = angle_diff(math.pi, r)
            if math.abs(fromPi) < MIN_BOUNCE_ANGLE {
                val sign = ((fromPi >= 0) && 1) || -1
                set result = math.pi - (sign * MIN_BOUNCE_ANGLE)
            }
        }
    }
    return(result)
}

;; single backward pass over the trail, satisfying every follower's
;; target distance in one walk instead of one walk per follower
val func sample_all_trail(trail, followerCount) {
    val results = []
    var distanceSum = 0
    var i = #trail
    var prev = trail@i
    var nextIdx = 1

    loop {
        set i = (i - 1)
        until(i < 1)

        val point = trail@i
        val dx = (point.x - prev.x)
        val dy = ((point.y - prev.y) / ASPECT_RATIO)
        set distanceSum = (distanceSum + math.sqrt((dx*dx) + (dy*dy)))

        loop {
            until((nextIdx > (followerCount - 1)) || (distanceSum < (SPACING * nextIdx)))
            set results@nextIdx = point
            set nextIdx = (nextIdx + 1)
        }
        if nextIdx > (followerCount - 1) {
            return(results)
        }

        set prev = point
    }

    ;; ran out of trail before satisfying everyone: fill remainder with oldest point
    loop {
        until(nextIdx > (followerCount - 1))
        set results@nextIdx = prev
        set nextIdx = (nextIdx + 1)
    }
    return(results)
}

val func bounce(r, nx, ny) {
    var result = r
    if nx == 0 {
        set result = (2 * math.pi) - result
    }
    if ny == 0 {
        set result = math.pi - result
    }
    return(result)
}

;; one point per wave, inset so the whole cluster still fits in the arena
;; and retried while it lands too close to the snake's head
val func cluster_centre() {
    val insetX = CLUSTER_RADIUS
    val insetY = (CLUSTER_RADIUS * ASPECT_RATIO)

    var pos = [ x=0.5, y=0.5 ]
    loop _ in CENTRE_TRIES {
        set pos = [
            x = ((ARENA_LEFT + insetX) + (math.random() * (ARENA_W - (2 * insetX)))),
            y = ((ARENA_TOP + insetY) + (math.random() * (ARENA_H - (2 * insetY)))),
        ]
        val dx = (pos.x - SNAKE_POS.x)
        val dy = ((pos.y - SNAKE_POS.y) / ASPECT_RATIO)
        until (math.sqrt((dx*dx) + (dy*dy)) >= CENTRE_MIN_DIST)
    }
    return(pos)
}

;; a spot in the cluster: uniform angle and radius, so the horde reads as
;; a clump denser in the middle rather than a ring
val func cluster_pos(centre) {
    val ang = (math.random() * 2 * math.pi)
    val dist = (math.random() * CLUSTER_RADIUS)
    return [
        x = (centre.x + (math.cos(ang) * dist)),
        y = (centre.y + (math.sin(ang) * dist * ASPECT_RATIO)),
    ]
}

val func enemy_in_range(range, pos) {
    loop _, t in ENEMIES {
        val dx = (t.pub.x - pos.x)
        val dy = ((t.pub.y - pos.y) / ASPECT_RATIO)
        val dist = math.sqrt((dx*dx) + (dy*dy))
        until (dist<=range, [ x=t.pub.x, y=t.pub.y ])
    }
}

val barW = 0.05
val barH = 0.03
val barGap = 0.01
val barY = 0.95
val border = 0.004
val cdH = 0.02
val cdGapY = 0.005

;; bars laid out left-to-right by spawn index
val func bar_left(index) { (0.02 + ((index - 1) * (barW + barGap))) }
;; trackW/trackH: the hollow inner area, inset from the outer
val trackW = (barW - (border * 2))
val trackH = (barH - (border * 2 * ASPECT_RATIO))

;; frame left behind once a unit is gone
val task DeadBar(index) {
    val leftEdge = bar_left(index)
    loop on :draw {
        pico.set.pencil [ color=COLORS.idle.bg ]
        pico.output.draw.rect [ "%", x=leftEdge, y=barY, w=barW, h=barH, anchor="W" ]
        pico.set.pencil [ color=:black ]
        pico.output.draw.rect [ "%", x=(leftEdge + border), y=barY, w=trackW, h=trackH, anchor="W" ]
    }
}

val task StatBars(index, colors) {
    val leftEdge = bar_left(index)
    val trackLeft = (leftEdge + border)

    var hp, maxHp = (100, 100)

    spawn {
        loop {
            val d = await :hp
            set hp = d.hp
            set maxHp = d.max
        }    
    }

    par {
        ;; healthbar
        loop on :draw {
            ;; greyed out healthbars moved to the end of statbars

            ;; outer frame
            pico.set.pencil [ color=colors.base ]
            pico.output.draw.rect [ "%", x=leftEdge, y=barY, w=barW, h=barH, anchor="W" ]

            ;; hollow track
            pico.set.pencil [ color=:black ]
            pico.output.draw.rect [ "%", x=trackLeft, y=barY, w=trackW, h=trackH, anchor="W" ]

            val fillWidth = (trackW * (hp / maxHp))
            ;; inner meter
            ;; edgecase, rect seems to inflate at exactly width = 0
            if fillWidth > 0 {
                pico.set.pencil [ color=colors.base ]
                pico.output.draw.rect [ "%", x=trackLeft, y=barY, w=fillWidth, h=trackH, anchor="W" ]
            }
        }
    } with {
        ;; cooldown bar sits just below the hp bar
        val cdY = (barY + (barH / 2) + cdGapY + (cdH / 2))
        val cdTrackH = (cdH - (border * 2 * ASPECT_RATIO))

        ;; cooldown bar
        loop {
            val data = await :ability_fired
            var elapsed = 0

            par :any {
                ;; edgecase, rect seems to inflate at exactly width = 0
                loop on :draw {
                    val cdFillW = (trackW * math.min((elapsed / data@1), 1))
                    if cdFillW > 0 {
                        pico.set.pencil [ color=colors.base ]
                        pico.output.draw.rect [ "%", x=trackLeft, y=cdY, w=cdFillW, h=cdTrackH, anchor="W" ]
                    }
                }
            } with {
                loop {
                    val us = await :clock
                    set elapsed = (elapsed + us)
                    until (elapsed >= data@1)
                }
            }
        }
    }
}

val task SnakeUnit(index, character, trail, positions, colors) {
    var pos = [ x=SNAKE_POS.x, y=SNAKE_POS.y, r=0 ]
    ;; hp shared through events instead of pub
    var hp, maxHp = (100, 100)

    ;; movement, no exit condition of its own;
    ;; cleaned up automatically on task cleanup (PATTERN #4)
    spawn {
        loop {
            ;; checked every tick now instead of once at spawn, so a
            ;; surviving unit can take over head duties if index 1 dies
            if (index == 1) {
                val us = await :clock
                val dt = us/1s;

                val m = pico.get.mouse('%')
                val dxVisual = (m.x - pos.x)
                val dyVisual = ((m.y - pos.y) / ASPECT_RATIO)
                val desired = math.atan(dyVisual, dxVisual)

                val diff = angle_diff(pos.r, desired)
                val maxTurn = (TURN_RATE * dt)
                val turn = math.max(math.min(diff, maxTurn), -maxTurn)

                set pos.r = (pos.r + turn)

                ;; direction without collision
                var nextX = (pos.x + (math.cos(pos.r) * HEAD_SPEED * dt))
                var nextY = (pos.y + (math.sin(pos.r) * HEAD_SPEED * dt * ASPECT_RATIO))

                val hitVertical = (nextX < ARENA_LEFT) || (nextX > ARENA_RIGHT)
                val hitHorizontal = (nextY < ARENA_TOP) || (nextY > ARENA_BOTTOM)

                ;; corner hit
                if hitVertical && hitHorizontal {
                    set pos.r = (pos.r + math.pi)
                } else {
                    if hitVertical {
                        set pos.r = bounce(pos.r, 1, 0)
                        set pos.r = clamp_away_from_wall(pos.r, true)
                    }
                    if hitHorizontal {
                        set pos.r = bounce(pos.r, 0, 1)
                        set pos.r = clamp_away_from_wall(pos.r, false)
                    }
                }
                
                if (hitVertical || hitHorizontal) {
                    emit(:flash_unit)
                }

                set nextX = math.max(math.min(nextX, ARENA_RIGHT), ARENA_LEFT)
                set nextY = math.max(math.min(nextY, ARENA_BOTTOM), ARENA_TOP)

                set pos.x = nextX
                set pos.y = nextY

                set SNAKE_POS.x = pos.x
                set SNAKE_POS.y = pos.y

                set trail@+ = [ x=pos.x, y=pos.y, r=pos.r ]
                if (#trail > TRAIL_MAX) {
                    table.remove(trail, 1)
                }

                val sampled = sample_all_trail(trail, #G.party)
                loop fi, s in sampled {
                    set positions@fi = s
                }
            } else {
                await :clock
                val s = positions@(index - 1)
                if s {
                    set pos.x = s.x
                    set pos.y = s.y
                    set pos.r = s.r
                }
            }
        }
    }

    ;; flash on hit, spring pop, spawned as a child same as movement
    spawn {
        loop {
            watching :flash_unit {
                loop on :draw {
                    pico.set.pencil [ color=colors.base ]
                    pico.output.draw.oval [ "%",
                        x=pos.x, y=pos.y,
                        w=UNIT_SIZE, h=(UNIT_SIZE * ASPECT_RATIO),
                    ]
                }
            }
            
            pin spring = spawn Spring.Simple(1.8)
            emit @spring :start

            watching (0.15*1s) {
                loop on :draw {
                    pico.set.pencil [ color=:white ]
                    pico.output.draw.oval [ "%",
                        x=pos.x, y=pos.y,
                        w=UNIT_SIZE * spring.pub.scale,
                        h=(UNIT_SIZE * ASPECT_RATIO) * spring.pub.scale,
                    ]
                }
            }
        }
    }

    ;; ability loop
    spawn {
        val ability = Abilities@character
        if !ability {
            return()    ;; TODO: atmos has no simple way to spawn only on condition
        }

        ;; abilities can either yield till
        ;; completion OR snake unit existence

        ;; Sentry unit's turrets (that stays alive
        ;; beyond one ability instance) is now possible

        pin castPool = tasks()
        
        ;; not return(): this block is transparent, so a return would
        ;; terminate SnakeUnit itself
        ;; cooldown before checking again (TODO: ok on startup?)
        loop on (ability.interval) {
            ;; check every tick until something's in range
            val enemy_pos = loop on :clock {
                until (enemy_in_range(ability.range, pos))
            }

            spawn @castPool ability.caster(pos, enemy_pos)
            emit :flash_unit
            emit @:parent :ability_fired [ ability.interval ]
        }
    }
    
    ;; death shift logic
    spawn {
        loop {
            val d = await :unit_death
            if (d.index < index) {
                set index = (index - 1)
            }
        }
    }

    ;; enemy collision
    val TOUCH_RADIUS = ((UNIT_SIZE/2) + (0.025/2))
    val TOUCH_KNOCKBACK = 0.05

    loop on :clock {
        loop _, t in ENEMIES {
            val dx = (t.pub.x - pos.x)
            val dy = ((t.pub.y - pos.y) / ASPECT_RATIO)
            if math.sqrt((dx*dx) + (dy*dy)) < TOUCH_RADIUS {
                emit @t :on_collided [ srcX=pos.x, srcY=pos.y, knockback=TOUCH_KNOCKBACK ]
                emit :flash_unit

                set hp = math.max(hp - 50, 0)
                emit @:parent :hp [ hp=hp, max=maxHp ]

                ;; death emit
                if hp <= 0 {
                    ;; index shifts down with the party, so it still points
                    ;; at this unit's own slot
                    table.remove(G.party, index)
                    emit @:global :unit_death [ index=index ]
                    return()
                }
            }
        }
    }
}

val task Slot(index, character, trail, positions) {
    val colors = COLORS@(CHARACTERS@character.color)
    
    spawn StatBars(index, colors)
    await SnakeUnit(index, character, trail, positions, colors)

    ;; ends with its unit, so the bars go with it
    index
}

val task Snake() {
    var trail = [[ x=0.5, y=0.5, r=0 ]]
    val positions = []
    val count = #G.party

    pin party = tasks()
    loop i, character in G.party {
        print("Spawning "++character++ " " ++ i)
        spawn @party Slot(i, character, trail, positions)
    }

    ;; each slot returns its index when its unit dies
    pin graves = tasks()
    loop _ in count {
        val i = await :any party
        spawn @graves DeadBar(i)
    }
}

val OVERLAY_DELAY = 0.5s    ;; swallows the click that was in flight when the run ended

;; PATTERN #1 : Finite State Machines : overlay -> input -> done
;;  - awaited inside Battle, so the arena is only torn down once the
;;    player acknowledges the outcome
;; TODO: draw over a frozen screenshot of the arena, like Transition does,
;;       instead of covering it
val task Outcome (msg, clr) {
    spawn {
        loop on :draw {
            pico.set.pencil [ color=:black ]
            pico.output.draw.rect [ '%', x=0.5, y=0.5, w=1, h=1 ]

            pico.set.pencil [ color=clr ]
            pico.output.draw.text.fix(msg, [ '%', x=0.5, y=0.45, h=0.08 ])

            pico.set.pencil [ color=COLORS.idle.fg ]
            pico.output.draw.text.fix("click to continue", [ '%', x=0.5, y=0.58, h=0.035 ])
        }
    }

    await(OVERLAY_DELAY)
    await :mouse.button.dn
}

;; PATTERN #5 : Signaling Mechanisms : :wave -> counter
;;  - the counter re-measures its rich text on a wave change instead of
;;    once per frame
val task Wave_Text (wave, maxWaves) {
    loop {
        val runs = parse_rich_text("WAVE: [yellow]" ++ wave.n ++ "/" ++ maxWaves)
        val positions, _ = measure_runs(runs, WAVE_TEXT_H)

        spawn {
            loop on :draw {
                loop i, run in runs {
                    val pos = positions@i
                    pico.set.pencil [ color=run.color ]
                    pico.output.draw.text.fix(run.text, [ '%',
                        x = (WAVE_TEXT_X + pos.start),
                        y = WAVE_TEXT_Y,
                        h = WAVE_TEXT_H,
                        anchor = "W",
                    ])
                }
            }
        }

        await :wave
    }
}

;; PATTERN #2 : Continuation Passing : wave -> wave -> result
;;  - a wave's spawn is followed by awaiting its own extinction, so the
;;    next wave is simply the next iteration
;; PATTERN #4 : Lifespan Hierarchies : Battle > Snake,enemies
;;  - returning from Battle aborts the snake and every surviving enemy,
;;    whatever state they are in

task Battle () {
    print("Battle Started!")

    spawn {
        loop on :draw{
            ;; battle arena
            pico.set.pencil [ color=COLORS.idle.bg ]
            pico.output.draw.rect([
                "%", x=0.5, y=0.5,
                w=ARENA_W, h=ARENA_H,
            ])
        }
    }

    pin enemies = tasks()
    set ENEMIES = enemies

    val maxWaves = level_waves(G.level)
    ;; boxed, so the counter reads the current wave without owning it
    val wave = [ n=1 ]
    spawn Wave_Text(wave, maxWaves)

    pin snake = spawn Snake()

    par :any {
        ;; Snake ends when its last slot does: the whole party is down
        await(snake)
        await Outcome("you died", COLORS.red.base)
        false
    } with {
        loop i in maxWaves {
            set wave.n = i
            emit :wave

            await(WAVE_DELAY)

            val centre = cluster_centre()
            loop _ in wave_enemies(i) {
                val p = cluster_pos(centre)
                spawn @ENEMIES Seeker(p.x, p.y)
            }

            ;; the pool empties only once every enemy of this wave is dead
            await :all ENEMIES
        }

        ;; the last level of a run has nothing to continue into
        if (G.level >= MAX_LEVEL) {
            await Outcome("you win!", COLORS.yellow.base)
        }
        true
    }
}

Battle
