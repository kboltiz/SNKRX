val Enemies = require "arena.enemies"
val Snake  = require "arena.snake"

;; waves per level, ported from SNKRX's level_to_max_waves
val LEVEL_WAVES = [
    2, 3, 4,
    3, 4, 4, 5,
    5, 5, 5, 5, 7,
    6, 6, 7, 7, 8, 10,
    8, 8, 10, 12, 14, 16, 25,
]

;; SNKRX waits 0.5s after an arena clears, plants its marker, and lands
;; the swarm 1.125s later. The marker's life is exactly that second gap
val WAVE_DELAY = 0.5s
val MARKER_LIFE = 1125ms
val MARKER_PX = 24            ;; the 24x6 bar SNKRX crosses over itself
val MARKER_BAR = (6/24)       ;; a bar's thickness, as a fraction of the layer
val MARKER_W = (MARKER_PX/480)
val MARKER_H = (MARKER_PX/270)
val MARKER_BLINK_LO = 195ms   ;; first gap between blinks, before it tightens
val MARKER_BLINK_HI = 240ms
val MARKER_DECAY_LO = 0.84    ;; each blink shortens the next gap by this
val MARKER_DECAY_HI = 0.87
val MARKER_POP_LO = 1.4       ;; spring:pull(0.4, 0.6) in the original
val MARKER_POP_HI = 1.6
val CLUSTER_RADIUS = 0.08     ;; how tightly a horde packs around its spawn point
;; keeps a horde off the snake's face; the arena is thin, so a larger
;; clearance leaves only its far ends available
val CENTRE_MIN_DIST = 0.15
val CENTRE_TRIES = 16         ;; bounded, so a cornered snake can still be spawned around

val WAVE_TEXT_X = 0.03        ;; top-left corner, above the arena
val WAVE_TEXT_Y = 0.06
val WAVE_TEXT_H = 0.04

val func char_base(character) { COLORS@(CHARACTERS@character.color).base }

val func level_waves(level) { LEVEL_WAVES@(math.min(level, #LEVEL_WAVES)) }
;; enemies in a wave, ported from SNKRX: 8 + (wave-1)*2
val func wave_enemies(wave) { (8 + ((wave - 1) * 2)) }

;; SNKRX rolls every spawn for an elite rather than adding one per wave:
;; the weights below sum to that spawn's percent chance of being one, and
;; the pick between them is weighted by the same numbers. Ported from
;; level_to_elite_spawn_weights / level_to_elite_spawn_types
val ELITE_WEIGHTS = [
    [0],        [4,2],      [10],       [4,4],      [4,3,2],
    [12],       [5,3,2],    [6,3,3,3],  [14],       [8,4],
    [8,6,2],    [16],       [8,8],      [12,6],     [18],
    [10,6,4],   [6,5,4,3],  [18],       [10,6],     [8,6,2],
    [22],       [10,8,4],   [20,5,5],   [30],       [5,5,5,5,5,5],
]

;; only :headbutter and :shooter exist so far; a roll landing on any of the
;; other four spawns a plain seeker, so the elite rate stays true to the
;; original even where the variant is still missing
val ELITE_TYPES = [
    [:speed_booster],
    [:speed_booster, :shooter],
    [:speed_booster],
    [:speed_booster, :exploder],
    [:speed_booster, :exploder, :shooter],
    [:speed_booster],
    [:speed_booster, :exploder, :headbutter],
    [:speed_booster, :exploder, :headbutter, :shooter],
    [:shooter],
    [:exploder, :headbutter],
    [:exploder, :headbutter, :tank],
    [:exploder],
    [:speed_booster, :shooter],
    [:speed_booster, :spawner],
    [:shooter],
    [:speed_booster, :exploder, :spawner],
    [:speed_booster, :exploder, :spawner, :shooter],
    [:spawner],
    [:headbutter, :tank],
    [:speed_booster, :tank, :spawner],
    [:headbutter],
    [:speed_booster, :headbutter, :tank],
    [:headbutter, :tank, :shooter],
    [:tank],
    [:speed_booster, :exploder, :headbutter, :tank, :shooter, :spawner],
]

;; nil for an ordinary seeker
val func roll_elite(level) {
    val idx = math.min(level, #ELITE_WEIGHTS)
    val weights = ELITE_WEIGHTS@idx
    val types = ELITE_TYPES@idx

    var total = 0
    loop _, w in weights {
        set total = (total + w)
    }
    if math.random(1, 100) > total {
        return(nil)
    }

    var pick = math.random(1, total)
    loop i, w in weights {
        set pick = (pick - w)
        if pick <= 0 {
            return(types@i)
        }
    }
    return(nil)
}

val func rand_between(lo, hi) { (lo + (math.random() * (hi - lo))) }

val COUNTDOWN_FROM = 3
val COUNTDOWN_Y = (87/270)      ;; gh/2 - 48
val COUNTDOWN_FLASH = 250ms     ;; hfx:use('condition1', 0.25, ...)
val COUNTDOWN_POP = 1.5

;; PATTERN #1 : Finite State Machines : 3 -> 2 -> 1 -> go
;;  - the count is the loop's own variable, and the run of the task is
;;    the countdown. Nothing else is told the arena has not started yet
;;
;; the snake is already loose while this runs, as it is in SNKRX: the
;; player gets the three seconds to position before anything spawns
val task Countdown () {
    var n = COUNTDOWN_FROM
    var clr = COLORS.red.base

    pin spring = spawn Spring.Simple(COUNTDOWN_POP)

    spawn {
        loop on :draw {
            pico.set.pencil [ font=FAT_FONT ]
            pico.set.pencil [ color=clr ]
            pico.output.draw.text.fix(tostring(n), [ '%',
                x = 0.5, y = COUNTDOWN_Y,
                h = (LINE_H * spring.pub.scale),
            ])
            pico.set.pencil [ font=FONT ]
        }
    }

    loop {
        await(1s)
        set n = (n - 1)
        until (n <= 0)      ;; zero is never shown, the waves start instead

        ;; whitens on the change, then settles back to red
        emit @spring :start
        set clr = COLORS.fg.base
        await(COUNTDOWN_FLASH)
        set clr = COLORS.red.base
    }
}

;; PATTERN #1 : Finite State Machines : shown -> hidden -> shown -> gone
;;  - the blink is the loop's own rhythm rather than a timer that has to
;;    be rescheduled, and the marker ends by outliving its `watching`
;;
;; SNKRX's SpawnMarker, ported from objects.lua: a red cross that flickers
;; faster the closer the swarm gets, then hands the spot over to it
val task Spawn_Marker (x, y) {
    var hidden = false

    pin spring = spawn Spring.Simple(rand_between(MARKER_POP_LO, MARKER_POP_HI))
    emit @spring :start

    ;; pico cannot turn a primitive, only a layer, so the cross is drawn
    ;; square into one of its own and the layer is what carries the angle
    val id = pico.layer.empty [ dim=['!', w=MARKER_PX, h=MARKER_PX] ]
    pico.set.layer(id)
    pico.set.effect [ rotate=[ angle=(math.random() * 360), anchor="C" ] ]
    pico.set.layer(:world)

    spawn {
        loop on :draw {
            if !hidden {
                pico.set.layer(id)
                pico.set.pencil [ color=COLORS.red.base ]
                pico.output.draw.rect [ '%', x=0.5, y=0.5, w=1, h=MARKER_BAR ]
                pico.output.draw.rect [ '%', x=0.5, y=0.5, w=MARKER_BAR, h=1 ]
                pico.set.layer(:world)

                pico.output.draw.layer(id, [ '%',
                    x = x, y = y,
                    w = (MARKER_W * spring.pub.scale),
                    h = (MARKER_H * spring.pub.scale),
                ])
            }
        }
    }

    var gap = rand_between(MARKER_BLINK_LO, MARKER_BLINK_HI)
    watching (MARKER_LIFE) {
        loop {
            await(gap)
            set hidden = !hidden
            set gap = (gap * rand_between(MARKER_DECAY_LO, MARKER_DECAY_HI))
        }
    }
}

;; PATTERN #1 : Finite State Machines : shown -> hidden -> shown -> gone
;;  - the blink is the loop's own rhythm rather than a timer that has to
;;    be rescheduled, and the marker ends by outliving its `watching`
;;
;; SNKRX's SpawnMarker, ported from objects.lua: a red cross that flickers
;; faster the closer the swarm gets, then hands the spot over to it
val task Spawn_Marker (x, y) {
    var hidden = false

    pin spring = spawn Spring.Simple(rand_between(MARKER_POP_LO, MARKER_POP_HI))
    emit @spring :start

    ;; pico cannot turn a primitive, only a layer, so the cross is drawn
    ;; square into one of its own and the layer is what carries the angle
    val id = pico.layer.empty [ dim=['!', w=MARKER_PX, h=MARKER_PX] ]
    pico.set.layer(id)
    pico.set.effect [ rotate=[ angle=(math.random() * 360), anchor="C" ] ]
    pico.set.layer(:world)

    spawn {
        loop on :draw {
            if !hidden {
                pico.set.layer(id)
                pico.set.pencil [ color=COLORS.red.base ]
                pico.output.draw.rect [ '%', x=0.5, y=0.5, w=1, h=MARKER_BAR ]
                pico.output.draw.rect [ '%', x=0.5, y=0.5, w=MARKER_BAR, h=1 ]
                pico.set.layer(:world)

                pico.output.draw.layer(id, [ '%',
                    x = x, y = y,
                    w = (MARKER_W * spring.pub.scale),
                    h = (MARKER_H * spring.pub.scale),
                ])
            }
        }
    }

    var gap = rand_between(MARKER_BLINK_LO, MARKER_BLINK_HI)
    watching (MARKER_LIFE) {
        loop {
            await(gap)
            set hidden = !hidden
            set gap = (gap * rand_between(MARKER_DECAY_LO, MARKER_DECAY_HI))
        }
    }
}

;; one point per wave, inset so the whole cluster still fits in the arena
;; and retried while it lands too close to the snake's head
val func cluster_centre() {
    val insetX = CLUSTER_RADIUS
    val insetY = (CLUSTER_RADIUS * ASPECT_RATIO)

    var pos = [ x=0.5, y=0.5 ]
    loop _ in CENTRE_TRIES {
        set pos = [
            x = ((ARENA_LEFT + insetX) + (math.random() * (ARENA_W - (2 * insetX)))),
            y = ((ARENA_TOP + insetY) + (math.random() * (ARENA_H - (2 * insetY)))),
        ]
        val dx = (pos.x - SNAKE_POS.x)
        val dy = ((pos.y - SNAKE_POS.y) / ASPECT_RATIO)
        until (math.sqrt((dx*dx) + (dy*dy)) >= CENTRE_MIN_DIST)
    }
    return(pos)
}

;; a spot in the cluster: uniform angle and radius, so the horde reads as
;; a clump denser in the middle rather than a ring
val func cluster_pos(centre) {
    val ang = (math.random() * 2 * math.pi)
    val dist = (math.random() * CLUSTER_RADIUS)
    return [
        x = (centre.x + (math.cos(ang) * dist)),
        y = (centre.y + (math.sin(ang) * dist * ASPECT_RATIO)),
    ]
}

val OVERLAY_DELAY = 0.5s    ;; swallows the click that was in flight when the run ended

;; the run's result, laid out where SNKRX puts it on a 480x270 screen.
;; both faces are 8px there, so a row is LINE_H and the rest is scaled
;; off it the way the original scales its Text2
val OUTCOME_Y = (103/270)           ;; gh/2 - 32
val OUTCOME_H = (LINE_H * 1.25)     ;; fat font, height_multiplier 1.25
val SCORE_Y = 0.5                   ;; gh/2
val SCORE_H = (LINE_H * 0.7)        ;; fat font at sx,sy 0.7
val CONTINUE_Y = (159/270)          ;; gh/2 + 24, where restart run (r) sits
val BUILD_X = (40/480)
val BUILD_Y = (20/270)
val BUILD_ROW_X = (20/480)
val BUILD_ROW_Y = (40/270)
val BUILD_ROW_STEP = (19/270)

val PAUSE_KEY = :Escape

;; PATTERN #6 : Pausing : the arena freezes but stays on screen
;;  - `toggle ... with :draw` suspends a task's reaction to everything
;;    except drawing, so the battle holds its exact state and keeps
;;    rendering it. Nothing has to be told it is paused
val task Pause_Overlay () {
    loop on :draw {
        pico.set.pencil [ color=COLORS.idle.fg ]
        pico.output.draw.text.fix("PAUSED", [ '%', x=0.5, y=0.5, h=0.06 ])
        pico.output.draw.text.fix("esc to resume", [ '%', x=0.5, y=0.58, h=0.03 ])
    }
}

;; PATTERN #1 : Finite State Machines : overlay -> input -> done
;;  - awaited inside Battle, so the arena is only torn down once the
;;    player acknowledges the outcome
;; TODO: draw over a frozen screenshot of the arena, like Transition does,
;;       instead of covering it
val task Outcome (msg, clr, party) {
    ;; the level is read now: a wipe rebuilds the run once Battle returns
    val level = G.level

    ;; measured in the face it is drawn in, so the runs line up
    pico.set.pencil [ font=FAT_FONT ]
    val runs = parse_rich_text("[fg]level reached: [yellow]" ++ level)
    val positions, width = measure_runs(runs, SCORE_H)
    pico.set.pencil [ font=FONT ]
    val scoreLeft = (0.5 - (width / 2))

    spawn {
        loop on :draw {
            pico.set.pencil [ color=:black ]
            pico.output.draw.rect [ '%', x=0.5, y=0.5, w=1, h=1 ]

            pico.set.pencil [ font=FAT_FONT ]

            pico.set.pencil [ color=clr ]
            pico.output.draw.text.fix(msg, [ '%', x=0.5, y=OUTCOME_Y, h=OUTCOME_H ])

            ;; the score, with the number picked out the way SNKRX does
            loop i, run in runs {
                val pos = positions@i
                pico.set.pencil [ color=run.color ]
                pico.output.draw.text.fix(run.text, [ '%',
                    x = (scoreLeft + pos.start + (pos.width / 2)),
                    y = SCORE_Y,
                    h = SCORE_H,
                ])
            }

            pico.set.pencil [ font=FONT ]

            ;; the party that got this far, down the left edge
            pico.set.pencil [ color=COLORS.fg.base ]
            pico.output.draw.text.fix("your build", [ '%',
                x=BUILD_X, y=BUILD_Y, h=LINE_H,
            ])
            loop i, character in party {
                pico.set.pencil [ color=char_base(character) ]
                pico.output.draw.text.fix(CHARACTERS@character.name, [ '%',
                    x = BUILD_ROW_X,
                    y = (BUILD_ROW_Y + ((i - 1) * BUILD_ROW_STEP)),
                    h = LINE_H,
                    anchor = "W",
                ])
            }

            pico.set.pencil [ color=COLORS.idle.fg ]
            pico.output.draw.text.fix("click to continue", [ '%',
                x=0.5, y=CONTINUE_Y, h=LINE_H,
            ])
        }
    }

    await(OVERLAY_DELAY)
    await :mouse.button.dn
}

;; PATTERN #5 : Signaling Mechanisms : :wave -> counter
;;  - the counter re-measures its rich text on a wave change instead of
;;    once per frame
val task Wave_Text (wave, maxWaves) {
    loop {
        val runs = parse_rich_text("WAVE: [yellow]" ++ wave.n ++ "/" ++ maxWaves)
        val positions, _ = measure_runs(runs, WAVE_TEXT_H)

        spawn {
            loop on :draw {
                loop i, run in runs {
                    val pos = positions@i
                    pico.set.pencil [ color=run.color ]
                    pico.output.draw.text.fix(run.text, [ '%',
                        x = (WAVE_TEXT_X + pos.start),
                        y = WAVE_TEXT_Y,
                        h = WAVE_TEXT_H,
                        anchor = "W",
                    ])
                }
            }
        }

        await :wave
    }
}

;; PATTERN #2 : Continuation Passing : wave -> wave -> result
;;  - a wave's spawn is followed by awaiting its own extinction, so the
;;    next wave is simply the next iteration
;; PATTERN #4 : Lifespan Hierarchies : Battle > Snake,enemies
;;  - returning from Battle aborts the snake and every surviving enemy,
;;    whatever state they are in

task Battle () {
    print("Battle Started!")

    spawn {
        loop on :draw{
            ;; battle arena
            pico.set.pencil [ color=COLORS.idle.bg ]
            pico.output.draw.rect([
                "%", x=0.5, y=0.5,
                w=ARENA_W, h=ARENA_H,
            ])
        }
    }

    pin enemies = tasks()
    set ENEMIES = enemies

    ;; shots belong to the battle, not to whoever fired them, so killing a
    ;; shooter leaves its shots in the air; keeping them out of ENEMIES also
    ;; keeps them out of the wave's death count, the seekers' separation and
    ;; the snake's targeting
    pin shots = tasks()
    set SHOTS = shots

    ;; the units drop themselves from G.party as they die, so the build
    ;; shown at the end has to be taken before the first one falls
    val startParty = []
    loop i, character in G.party {
        set startParty@i = character
    }

    val maxWaves = level_waves(G.level)
    ;; boxed, so the counter reads the current wave without owning it
    val wave = [ n=1 ]
    spawn Wave_Text(wave, maxWaves)

    pin snake = spawn Snake()

    par :any {
        ;; Snake ends when its last slot does: the whole party is down
        await(snake)
        await Outcome("you died...", COLORS.red.base, startParty)
        false
    } with {
        await Countdown()

        loop i in maxWaves {
            set wave.n = i
            emit :wave

            await(WAVE_DELAY)

            val centre = cluster_centre()

            ;; the spot is marked first, and the swarm arrives as the
            ;; marker goes out
            await Spawn_Marker(centre.x, centre.y)

            ;; an elite takes the place of a seeker rather than adding to
            ;; the count, so the wave size stays 8 + (wave-1)*2
            loop _ in wave_enemies(i) {
                val p = cluster_pos(centre)
                val elite = roll_elite(G.level)
                ifs {
                    (elite == :headbutter) => {
                        spawn @ENEMIES Enemies.headbutter(p.x, p.y)
                    }
                    (elite == :shooter) => {
                        spawn @ENEMIES Enemies.shooter(p.x, p.y, SHOTS)
                    }
                    else => {
                        spawn @ENEMIES Enemies.seeker(p.x, p.y)
                    }
                }
            }

            ;; the pool empties only once every enemy of this wave is dead
            await :all ENEMIES
        }

        ;; the last level of a run has nothing to continue into
        if (G.level >= MAX_LEVEL) {
            await Outcome("you win!", COLORS.yellow.base, startParty)
        }
        true
    } with {
        ;; PATTERN #6 : Pausing : snake, enemies and shots at once
        ;;  - every one of them is already held here, so pausing is three
        ;;    toggles rather than a flag each of them has to check
        loop {
            await :key.dn [key=PAUSE_KEY]

            toggle snake(false) with :draw
            toggle enemies(false) with :draw
            toggle shots(false) with :draw

            watching :key.dn [key=PAUSE_KEY] {
                await Pause_Overlay()
            }

            toggle snake(true)
            toggle enemies(true)
            toggle shots(true)
        }
    }
}

Battle
