val PAD = 0.03
val POPUP_PAD = 0.1
val LINE_H = 0.04

task Popup (lines) {
    val parsed = []
    var maxWidth = 0

    loop i, line in lines {
        val runs = parse_rich_text(line)
        val positions, width = measure_runs(runs, LINE_H)
        set parsed@i = [ runs=runs, positions=positions, width=width ]
        if width > maxWidth {
            set maxWidth = width
        }
    }

    val totalHeight = #lines * LINE_H

    ;; calculate full rect to cover
    val fullRect = [ '%',
        x = 0.5, y = 0.5,
        w = maxWidth / (1 - POPUP_PAD),
        h = totalHeight / (1 - POPUP_PAD),
    ]

    pin spring = spawn Spring(1.1)
    emit @spring :start

    ;; TODO: popup layer may be required to draw it on top
    loop on :draw {
        val r = fullRect ++ [
            w = fullRect.w * spring.pub.scale,
            h = fullRect.h * spring.pub.scale,
        ]

        pico.set.pencil [ color=COLORS.idle.bg ]
        pico.output.draw.rect(r)

        val blockTop = r.y - ((totalHeight * spring.pub.scale) / 2)

        loop i, entry in parsed {
            val rowY = blockTop + (((i - 1) + 0.5) * LINE_H * spring.pub.scale)
            val rowStart = r.x - ((entry.width * spring.pub.scale) / 2)

            loop ri, run in entry.runs {
                val pos = entry.positions@ri
                pico.set.pencil [ color=run.color ]
                pico.output.draw.text(run.text, [ '%',
                    x = rowStart + ((pos.start + (pos.width / 2)) * spring.pub.scale),
                    y = rowY,
                    h = LINE_H * (1 - POPUP_PAD) * spring.pub.scale,
                ])
            }
        }
    }

    await(false)
}

val task CharacterIcon (up, rect, character, number, showName) {
    val charColorGroup = CHARACTERS@character.color
    val charColors = COLORS@charColorGroup

    pin obj = spawn Object(nil, up, rect, 1)

    do {
        pico.set.layer(up)
        pico.set.pencil [ font=FONT ]

        pico.set.pencil [ color=charColors.base ]
        pico.output.draw.rect(rect)

        pico.set.pencil [ color=charColors.text ]
        pico.output.draw.text(tostring(number)) <- [
            '%', x=rect.x, y=rect.y, h=rect.h*0.9,
        ]

        if showName {
            pico.set.pencil [ color=charColors.base ]
            pico.output.draw.text(character) <- [
                '%', x=rect.x, y=(rect.y + rect.h), h=rect.h*0.9,
            ]
        }

        pico.set.layer(:world)
    }

    ;; TODO, cost calculation of unit
    val cost = 0;

    val headerColor, labelColor, effectText =
        if (G.level == 3)
            => (:yellow, :idle,  CHARACTERS@character.effect_description)
            => (:hover,  :hover, CHARACTERS@character.effect_description)

    val classList = CHARACTERS@character.classes
    var formattedClasses = []

    loop i, c in classList {
        val classColor = (
            if (CLASSES@c.color == nil) => :idle => CLASSES@c.color
        )
        set formattedClasses = formattedClasses ++ ['[' ++ classColor ++ ']' ++ c]
    }

    val popupText = [ s1, s2, s3, s4, s5 ] where {
        s1 = '[' ++ CHARACTERS@character.color ++ ']' ++
             CHARACTERS@character.name ++ "[idle] - cost: [gold]" ++ cost
        s2 = "[idle]Classes: " ++ table.concat(formattedClasses, "[idle], ")
        s3 = CHARACTERS@character.description
        s4 = '[' ++ headerColor ++ ']' ++
             "Lv.3 [" ++ labelColor ++ ']' ++
             "Effect - " ++ CHARACTERS@character.effect_name
        s5 = effectText
    }

    loop {
        await :o.over.on [obj=obj.pub]
        spawn Popup(popupText)
        await :o.over.off [obj=obj.pub]
    }
}

val task PartyColumnCell (slot, character) {
    val id = "party." ++ slot
    var cur = slot

    val h = 0.08
    val rct = [ '%',
        x = 0.95,
        y = 0.1 + (cur * h),
        w = 0.03,
        h = 0.03 * ASPECT_RATIO,
    ]

    pin obj = spawn Object(id, nil, rct, 1)

    pico.layer.empty [ mode='~', key=id, target=rct ]

    spawn CharacterIcon(id, r, character, 1, false) where {
        r = [ '%', x=0.5, y=0.5, w=1, h=1 ]
    }

    par {
        loop on :draw {
            pico.output.draw.layer(id)
        }
    } with {
        loop e on :slot until (it@1==cur) || (it@2==cur) {
            val to = ifs {
                (e@1 == cur) => e@2
                (e@2 == cur) => e@1
            }
            set cur = to
            set rct.y = 0.1 + (to * h)
            pico.set.layer(id)
            pico.set.scene [ target=rct ]
            pico.set.layer :world
        }
    } with {
        loop on :o.click.dn [id=id] {                
            watching :mouse.button.up {
                loop on :mouse.motion {
                    val mouse = pico.get.mouse '%'
                    ifs {
                        (mouse.y >= (rct.y + 0.08)) && (cur < #G.party) =>
                            emit @(:parent) :slot [cur, cur+1]
                        (mouse.y <= (rct.y - 0.08)) && (cur > 1) =>
                            emit @(:parent) :slot [cur, cur-1]
                    }
                }
            }
        }
    }
}

val func class_banners (id, rect, character) {
    val charClasses = CHARACTERS@character.classes
    val charClassesCount = #charClasses
    val cardAspectRatio = rect.w / rect.h

    pico.set.layer(id)

    ;; TODO: color the class icon to COLORS.hover.fg
    loop i, class in charClasses {
        ;; center + (divided_x * spacing)
        val x = 0.5 + ((i - ((charClassesCount + 1)/2)) * 0.23)

        pico.set.pencil [ color=COLORS.idle.bg ]
        pico.output.draw.rect([
            '%', x=x, y=0.56,
            w=0.2, h=0.33 * cardAspectRatio * ASPECT_RATIO,
        ])

        pico.set.pencil [ color=COLORS.idle.fg ]
        pico.output.draw.image("../assets/images/" ++ class ++ ".png") <- [
            '%', x=x, y=0.56,
            w=0.17,
            h=0.17 * CLASS_ICON_ASPECT_RATIO * cardAspectRatio * ASPECT_RATIO,
        ]
    }

    pico.set.layer(:world)
}

val task Card (slot, character) {
    val id = "card." ++ slot

    val dim = [ '%', w=0.16, h=0.2*ASPECT_RATIO ]
    val rat = dim.w / dim.h
    val rct = [ '%', x=slot*0.16, y=0.3, w=dim.w, h=dim.h ]

    pin obj = spawn Object(id, nil, rct, 1)
    pin spr = spawn Spring(1.3)

    pico.layer.empty [ mode='~', key=id, dim=dim, target=rct ]

    spawn {
        loop on :draw {
            set rct.w = dim.w * spr.pub.scale
            set rct.h = dim.h * spr.pub.scale
            if obj.pub.over {
                pico.set.pencil [ color=COLORS.idle.bg ] ;; TODO: verify color
                pico.output.draw.rect(rct)
            }
            pico.output.draw.layer(id, rct)
        }
    }

    spawn CharacterIcon(id, r, character, 1, true) where {
        r = [ '%', x=0.5, y=0.2, h=(0.2 * rat * ASPECT_RATIO), w=0.2 ]
    }
    class_banners(id, rct, character)

    spawn {
        loop {
            if obj.pub.over {
                emit @spr :start
                pico.output.sound(SOUNDS.hover)
            }
            await :o.over.on [id=id]
        }
    }

    await :o.click.dn [id=id]
    pico.output.sound(SOUNDS.pop)
    id
}

val func roll_cards () {
    ;; TODO: port tier_weights / weighted_pick from the Lua roll logic
    return [
        :swordsman,
        :wizard,
        :swordsman,
    ]
}

val task Shop () {
    spawn Button(:go, 2, rect, "Go!") where {
        rect = ['%', x=0.88, y=0.9, h=0.1]
    }

    spawn {
        loop {
            spawn RichTextButton(:reroll, 1, rct, lbl) where {
                rct = ['%', x=0.28, y=0.06, h=0.07]
                lbl = "[idle]Rerolls: [gold]" ++ G.rerolls
            }

            pin cs = tasks()
            loop i, character in roll_cards() {
                spawn @cs Card(i, character)
            }

            await :o.click.dn [id=:reroll] until (G.rerolls > 0)
            set G.rerolls = (G.rerolls - 1)
        }
    }

    spawn {
        loop {
            pin ps = tasks()
            loop i, character in G.party {
                spawn @ps PartyColumnCell(i, character)
            }
            await(false)    ;; TODO: awakes on each card click?
        }
    }

    par:any {
        await :o.click.dn [id=:go]
        true
    } with {
        await :key.dn [key=:Escape]
        false
    }
}

Shop
