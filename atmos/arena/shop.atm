val PAD = 0.03

val Icons = require "arena.icon"
val Popup = Icons.Popup
val Char_Icon = Icons.Char_Icon

;; run progress, centred along the bottom edge
val LEVEL_Y = 0.94
val LEVEL_H = 0.04

;; SNKRX's InfoText, in the port's units. It sits 10px below the centre of
;; a 480x270 screen, in a box padded 16px wide and 4px tall, with the text
;; itself nudged 2px lower than the box, and lasts 2 seconds
val INFO_SECS = 2s
val INFO_Y = (145/270)          ;; gh/2 + 10
val INFO_TEXT_Y = (147/270)     ;; the same, + the 2px text nudge
val INFO_PAD_W = (16/480)
val INFO_PAD_H = (4/270)
val INFO_BG = [ '%', r=0.138, g=0.138, b=0.138 ]   ;; SNKRX's bg[-2]

;;;
;; TODO : fsantanna : unreviewed
;;;

;; PATTERN #1 : Finite State Machines : shown -> gone
;;  - the message is the task: it ends on its own, so whoever awaits it
;;    is simply held for as long as it is up
val task Info_Text (line) {
    val runs = parse_rich_text(line)
    val positions, width = measure_runs(runs, LINE_H)
    val left = (0.5 - (width / 2))

    watching (INFO_SECS) {
        loop on :draw {
            pico.set.pencil [ color=INFO_BG ]
            pico.output.draw.rect [ '%',
                x = 0.5, y = INFO_Y,
                w = (width + INFO_PAD_W),
                h = (LINE_H + INFO_PAD_H),
            ]

            loop i, run in runs {
                val pos = positions@i
                pico.set.pencil [ color=run.color ]
                pico.output.draw.text.fix(run.text, [ '%',
                    x = (left + pos.start + (pos.width / 2)),
                    y = INFO_TEXT_Y,
                    h = LINE_H,
                ])
            }
        }
    }
}

;; PATTERN #4 : Lifespan Hierarchies : Cell > Icon
;;  - Cell (handles drag) owns Icon (handles draw and is reused elsewhere)
;;  - (same for Object)
;; PATTERN #5 : Signaling Mechanisms : :slot -> up pool
;;  - cell drag signals pool with colliding ids
;; PATTERN #1 : Finite State Machines : drag n' drop
;;  - click -> motion -> release

val task Party_Cell (slot, char) {
    var cur = slot

    val h = 0.08
    set pub = [
        id       = nil,     ;; see below
        char     = char,
        dragging = false,
        rect = [ '%',
            x = 0.95,
            y = 0.1 + (cur * h),
            w = 0.03,
            h = 0.03 * ASPECT_RATIO,
        ],
    ]
    set pub.id = pico.layer.empty [ dim=pub.rect ]

    spawn Object(task, 1)

    ;; v->f(...) is same as f(v, ...)
    ;; spawn Char_Icon(task, r, 1, false)
    spawn task->Char_Icon(r, 1, false) where {
        r = [ '%', x=0.5, y=0.5, w=1, h=1 ]
    }

    par {
        loop on :draw {
            pico.output.draw.layer(pub.id, pub.rect)
        }
    } with {
        loop e on :slot until ((it@1==cur) || (it@2==cur)) {
            val to = ifs {
                (e@1 == cur) => e@2
                (e@2 == cur) => e@1
            }
            set cur = to
            if (!pub.dragging) {
                set pub.rect.y = (0.1 + (to * h))
            }
        }
    } with {
        loop on :o.click.dn [me=task] {
            set pub.dragging = true
            watching :mouse.button.up {
                loop on :mouse.motion {
                    val mouse = pico.get.mouse '%'
                    set pub.rect.y = mouse.y

                    ifs {
                        ((mouse.y >= ((0.1 + (cur * h)) + 0.08)) && (cur < #G.party)) => {
                            val to = (cur + 1)

                            val tmp = G.party@cur
                            set G.party@cur = G.party@to
                            set G.party@to = tmp

                            emit @:parent :slot [cur, to]
                            set cur = to
                        }
                        ((mouse.y <= ((0.1 + (cur * h)) - 0.08)) && (cur > 1)) => {
                            val to = (cur - 1)

                            val tmp = G.party@cur
                            set G.party@cur = G.party@to
                            set G.party@to = tmp

                            emit @:parent :slot [cur, to]
                            set cur = to
                        }
                    }
                }
            }

            set pub.dragging = false
            set pub.rect.y = (0.1 + (cur * h))
        }
    }
}

val func class_banners (me) {
    val charClasses = CHARACTERS@(me.pub.char).classes
    val charClassesCount = #charClasses
    val cardAspectRatio = me.pub.rect.w / me.pub.rect.h

    pico.set.layer(me.pub.id)

    ;; TODO: color the class icon to COLORS.hover.fg
    loop i, class in charClasses {
        ;; center + (divided_x * spacing)
        val x = 0.5 + ((i - ((charClassesCount + 1)/2)) * 0.23)

        pico.set.pencil [ color=COLORS.idle.bg ]
        pico.output.draw.rect([
            '%', x=x, y=0.56,
            w=0.2, h=0.33 * cardAspectRatio * ASPECT_RATIO,
        ])

        pico.set.pencil [ color=COLORS.idle.fg ]
        pico.output.draw.image("../assets/images/" ++ class ++ ".png") <- [
            '%', x=x, y=0.56,
            w=0.17,
            h=0.17 * CLASS_ICON_ASPECT_RATIO * cardAspectRatio * ASPECT_RATIO,
        ]
    }

    pico.set.layer(:world)
}

;; PATTERN #4 : Lifespan Hierarchies : Card > Object,Spring,Char_Icon
;;  - Card encapsulates its constituents, which are restricted to its lifespan.

val task Card (slot, char) {
    val dim = [ '%', w=0.16, h=0.2*ASPECT_RATIO ]
    val rat = dim.w / dim.h

    set pub = [
        id   = nil,     ;; see below
        rect = [ '%', x=slot*0.16, y=0.3, w=dim.w, h=dim.h ],
        char = char,
    ]
    set pub.id = pico.layer.empty [ target=pub.rect ]
    
    spawn Object(task, 1)
    spawn Spring.Object(task, 1.3)

    spawn {
        loop on :draw {
            if pub.over {
                pico.set.pencil [ color=COLORS.idle.bg ] ;; TODO: verify color
                pico.output.draw.rect(pub.spring.rect)
            }
            pico.output.draw.layer(pub.id, pub.spring.rect)
        }
    }

    val cost = G.cost@char

    spawn task->Char_Icon(r, cost, true) where {
        r = [ '%', x=0.5, y=0.2, h=(0.2 * rat * ASPECT_RATIO), w=0.2 ]
    }
    task->class_banners()

    await :o.click.dn [me=task] until ((G.gold>=cost) && (#G.party<10))
    pico.output.sound(SOUNDS.pop)
    char
}

;; SNKRX's level_to_shop_odds: the chance a card comes from tier 1..4,
;; by shop level. The port has no shop upgrade yet, so it rolls at 1
val SHOP_ODDS = [
    [70, 20, 10, 0],
    [50, 30, 15, 5],
    [25, 45, 20, 10],
    [10, 25, 45, 20],
    [5,  15, 30, 50],
]
val SHOP_LEVEL = 1
val CARDS = 3
val TIER_TRIES = 8      ;; bounded, since most tiers are still empty

;; a character's cost is its tier, as it is in the original
val func tier_chars (tier) {
    val out = []
    loop name, _ in CHARACTERS {
        if (G.cost@name == tier) {
            set out@+ = name
        }
    }
    return(out)
}

val func roll_tier () {
    val weights = SHOP_ODDS@SHOP_LEVEL
    var total = 0
    loop _, w in weights {
        set total = (total + w)
    }

    var pick = math.random(1, total)
    loop i, w in weights {
        set pick = (pick - w)
        if pick <= 0 {
            return(i)
        }
    }
    return(1)
}

val func roll () {
    val out = []
    loop i in CARDS {
        ;; roll a tier, then anyone from it. A tier nobody fills yet is
        ;; rolled again rather than left as a blank card
        var chars = []
        loop _ in TIER_TRIES {
            set chars = tier_chars(roll_tier())
            until (#chars > 0)
        }
        if #chars == 0 {
            set chars = tier_chars(1)
        }
        set out@i = chars@(math.random(1, #chars))
    }
    return(out)
}

;; PATTERN #4 : Lifespan Hierarchies : Shop > Widgets (go,roll,cards,party)
;;  - Shop owns all widgets which nest complex behavior, safely aborting them
;;    on termination, regardless of their state.
;; PATTERN #7 : Dynamic Collections : TODO

val task Shop () {
    ;; GO
    spawn Button(:go, 2, rect, "Go!") where {
        rect = ['%', x=0.88, y=0.9, h=0.1]
    }

    ;; PARTY
    pin ps = tasks()
    loop i, char in G.party {
        spawn @ps Party_Cell(i, char)
    }

    ;; LEVEL
    spawn {
        val label = "Lvl." ++ G.level
        loop on :draw {
            pico.set.pencil [ color=COLORS.idle.fg ]
            pico.output.draw.text.fix(label, [ '%',
                x = 0.5, y = LEVEL_Y, h = LEVEL_H,
            ])
        }
    }

    ;; GOLD
    spawn {
        loop {
            val runs = parse_rich_text("shop - gold: [gold]" ++ G.gold)
            val positions, totalWidth = measure_runs(runs, 0.04 * (1 - PAD))
            spawn {
                loop on :draw {
                    loop i, run in runs {
                        val pos = positions@i
                        pico.set.pencil [ color=run.color ]
                        pico.output.draw.text.fix(run.text, [
                            '%',
                            x = 0.03 + pos.start,
                            y = 0.06,
                            h = 0.04 * (1 - PAD),
                            anchor = "W"
                        ])
                    }
                }
            }
            val e = await :gold
            set G.gold = G.gold - e.v
            assert(G.gold >= 0)
        }
    }

    ;; CARDS / REROLL
    spawn {
        loop {
            spawn RichTextButton(:roll, 1, rct, lbl) where {
                rct = ['%', x=0.34, y=0.06, h=0.04]
                lbl = "[idle]Rerolls: [gold]" ++ G.rolls
            }

            pin cs = tasks()
            loop i, char in roll() {
                spawn @cs Card(i, char)
            }

            spawn {
                loop char on :any cs {
                    set G.party@+ = char
                    spawn @ps Party_Cell(#ps+1, char)
                    emit :gold [v=G.cost@char]
                }
            }

            await :o.click.dn [id=:roll] until ((G.rolls>0) && (G.gold>=2))
            set G.rolls = (G.rolls - 1)
            emit :gold [v=2]
        }
    }

    par:any {
        ;; a click on an empty party refuses and says so for a moment,
        ;; the way SNKRX answers it, instead of leaving the button dead
        loop {
            await :o.click.dn [id=:go]
            until (#G.party > 0)

            await Info_Text("[fg]cannot start the round with [yellow]0 [fg]units")
        }
        true    ;; Go!
    } with {
        await :key.dn [key=:Escape]
        false   ;; ESC
    }
}

Shop
