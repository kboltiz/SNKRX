val PAD = 0.03
val POPUP_PAD = 0.1
val LINE_H = 0.03

;;;
;; TODO : fsantanna : unreviewed
;;;

task Popup (lines) {
    val parsed = []
    var maxWidth = 0

    loop i, line in lines {
        val runs = parse_rich_text(line)
        val positions, width = measure_runs(runs, LINE_H)
        set parsed@i = [ runs=runs, positions=positions, width=width ]
        if width > maxWidth {
            set maxWidth = width
        }
    }

    val totalHeight = #lines * LINE_H

    ;; calculate full rect to cover
    val fullRect = [ '%',
        x = 0.5, y = 0.5,
        w = maxWidth / (1 - POPUP_PAD),
        h = totalHeight / (1 - POPUP_PAD),
    ]

    pin spring = spawn Spring.Simple(1.1)
    emit @spring :start

    ;; TODO: popup layer may be required to draw it on top
    loop on :draw {
        val r = fullRect ++ [
            w = fullRect.w * spring.pub.scale,
            h = fullRect.h * spring.pub.scale,
        ]

        pico.set.pencil [ color=COLORS.idle.bg ]
        pico.output.draw.rect(r)

        val blockTop = r.y - ((totalHeight * spring.pub.scale) / 2)

        loop i, entry in parsed {
            val rowY = blockTop + (((i - 1) + 0.5) * LINE_H * spring.pub.scale)
            val rowStart = r.x - ((entry.width * spring.pub.scale) / 2)

            loop ri, run in entry.runs {
                val pos = entry.positions@ri
                pico.set.pencil [ color=run.color ]
                pico.output.draw.text(run.text, [ '%',
                    x = rowStart + ((pos.start + (pos.width / 2)) * spring.pub.scale),
                    y = rowY,
                    h = LINE_H * (1 - POPUP_PAD) * spring.pub.scale,
                ])
            }
        }
    }

    await(false)
}

;; PATTERN #4 : Lifespan Hierarchies : Char_Icon > loop > Popup
;;  - nested loop owns Popup, which aborts on each iteration
;; PATTERN #1 : Finite State Machines : Popup show/hide
;;  - over on -> show -> off -> hide

val task Char_Icon (me, rect, cost, showName) {
    val char = me.pub.char
    val charColorGroup = CHARACTERS@char.color
    val charColors = COLORS@charColorGroup

    spawn {
        loop on :draw {
            pico.set.layer(me.pub.id)
            pico.set.pencil [ font=FONT ]

            val rectColor = (if me.pub.dragging => COLORS.idle.bg => charColors.base)
            val textColor = (if me.pub.dragging => COLORS.idle.fg => charColors.text)            
            
            pico.set.pencil [ color=rectColor ]
            pico.output.draw.rect(rect)

            pico.set.pencil [ color=textColor ]
            pico.output.draw.text(tostring(cost)) <- [
                '%', x=rect.x, y=rect.y, h=(rect.h*0.6),
            ]

            if showName {
                pico.set.pencil [ color=charColors.base ]
                pico.output.draw.text(me.pub.char) <- [
                    '%', x=rect.x, y=(rect.y + rect.h), h=(rect.h*0.6),
                ]
            }

            pico.set.layer(:world)
        }
    }

    val headerColor, labelColor, effectText =
        if (G.level == 3)
            => (:yellow, :idle,  CHARACTERS@char.effect_description)
            => (:hover,  :hover, CHARACTERS@char.effect_description)

    val classList = CHARACTERS@char.classes
    var formattedClasses = []

    loop i, c in classList {
        val classColor = (
            if (CLASSES@c.color == nil) => :idle => CLASSES@c.color
        )
        set formattedClasses = formattedClasses ++ ['[' ++ classColor ++ ']' ++ c]
    }

    ;; popup

    do {
        set pub = [
            id    = me.pub.id,
            layer = me.pub.id,
            rect  = rect,
        ]

        spawn Object(task, 1)

        val text = [ s1, s2, s3, s4, s5 ] where {
            s1 = '[' ++ CHARACTERS@char.color ++ ']' ++
                 CHARACTERS@char.name ++ "[idle] - cost: [gold]" ++ cost
            s2 = "[idle]Classes: " ++ table.concat(formattedClasses, "[idle], ")
            s3 = CHARACTERS@char.description
            s4 = '[' ++ headerColor ++ ']' ++
                 "Lv.3 [" ++ labelColor ++ ']' ++
                 "Effect - " ++ CHARACTERS@char.effect_name
            s5 = effectText
        }

        loop {
            await :o.over.on [me=task]
            spawn Popup(text)
            await :o.over.off [me=task]
        }
    }
}

;; PATTERN #4 : Lifespan Hierarchies : Cell > Icon
;;  - Cell (handles drag) owns Icon (handles draw and is reused elsewhere)
;;  - (same for Object)
;; PATTERN #5 : Signaling Mechanisms : :slot -> up pool
;;  - cell drag signals pool with colliding ids
;; PATTERN #1 : Finite State Machines : drag n' drop
;;  - click -> motion -> release

val task Party_Cell (slot, char) {
    var cur = slot

    val h = 0.08
    set pub = [
        id       = nil,     ;; see below
        char     = char,
        dragging = false,
        rect = [ '%',
            x = 0.95,
            y = 0.1 + (cur * h),
            w = 0.03,
            h = 0.03 * ASPECT_RATIO,
        ],
    ]
    set pub.id = pico.layer.empty [ target=pub.rect ]

    spawn Object(task, 1)

    ;; v->f(...) is same as f(v, ...)
    ;; spawn Char_Icon(task, r, 1, false)
    spawn task->Char_Icon(r, 1, false) where {
        r = [ '%', x=0.5, y=0.5, w=1, h=1 ]
    }

    par {
        loop on :draw {
            pico.output.draw.layer(pub.id)
        }
    } with {
        loop e on :slot until (it@1==cur) || (it@2==cur) {
            val to = ifs {
                (e@1 == cur) => e@2
                (e@2 == cur) => e@1
            }
            set cur = to
            if (!pub.dragging) {
                set pub.rect.y = (0.1 + (to * h))
                pico.set.layer(pub.id)
                pico.set.scene [ target=pub.rect ]
                pico.set.layer :world
            }
        }
    } with {
        loop on :o.click.dn [me=task] {
            set pub.dragging = true
            watching :mouse.button.up {
                loop on :mouse.motion {
                    val mouse = pico.get.mouse '%'
                    set pub.rect.y = mouse.y
                    pico.set.layer(pub.id)
                    pico.set.scene [ target=pub.rect ]
                    pico.set.layer :world

                    ifs {
                        ((mouse.y >= ((0.1 + (cur * h)) + 0.08)) && (cur < #G.party)) => {
                            val to = (cur + 1)

                            val tmp = G.party@cur
                            set G.party@cur = G.party@to
                            set G.party@to = tmp
                            
                            emit @(:parent) :slot [cur, to]
                            set cur = to
                        }
                        ((mouse.y <= ((0.1 + (cur * h)) - 0.08)) && (cur > 1)) => {
                            val to = (cur - 1)
                            
                            val tmp = G.party@cur
                            set G.party@cur = G.party@to
                            set G.party@to = tmp
                            
                            emit @(:parent) :slot [cur, to]
                            set cur = to
                        }
                    }
                }
            }
            
            set pub.dragging = false
            set pub.rect.y = (0.1 + (cur * h))
            pico.set.layer(pub.id)
            pico.set.scene [ target=pub.rect ]
            pico.set.layer :world
        }
    }
}

val func class_banners (me) {
    val charClasses = CHARACTERS@(me.pub.char).classes
    val charClassesCount = #charClasses
    val cardAspectRatio = me.pub.rect.w / me.pub.rect.h

    pico.set.layer(me.pub.id)

    ;; TODO: color the class icon to COLORS.hover.fg
    loop i, class in charClasses {
        ;; center + (divided_x * spacing)
        val x = 0.5 + ((i - ((charClassesCount + 1)/2)) * 0.23)

        pico.set.pencil [ color=COLORS.idle.bg ]
        pico.output.draw.rect([
            '%', x=x, y=0.56,
            w=0.2, h=0.33 * cardAspectRatio * ASPECT_RATIO,
        ])

        pico.set.pencil [ color=COLORS.idle.fg ]
        pico.output.draw.image("../assets/images/" ++ class ++ ".png") <- [
            '%', x=x, y=0.56,
            w=0.17,
            h=0.17 * CLASS_ICON_ASPECT_RATIO * cardAspectRatio * ASPECT_RATIO,
        ]
    }

    pico.set.layer(:world)
}

;; PATTERN #4 : Lifespan Hierarchies : Card > Object,Spring,Char_Icon
;;  - Card encapsulates its constituents, which are restricted to its lifespan.

val task Card (slot, char) {
    val dim = [ '%', w=0.16, h=0.2*ASPECT_RATIO ]
    val rat = dim.w / dim.h

    set pub = [
        id   = nil,     ;; see below
        rect = [ '%', x=slot*0.16, y=0.3, w=dim.w, h=dim.h ],
        char = char,
    ]
    set pub.id = pico.layer.empty [ target=pub.rect ]

    spawn Object(task, 1)
    spawn Spring.Object(task, 1.3)

    spawn {
        loop on :draw {
            if pub.over {
                pico.set.pencil [ color=COLORS.idle.bg ] ;; TODO: verify color
                pico.output.draw.rect(pub.spring.rect)
            }
            pico.output.draw.layer(pub.id, pub.spring.rect)
        }
    }
    
    val unit_cost = 1;

    spawn task->Char_Icon(r, unit_cost, true) where {
        r = [ '%', x=0.5, y=0.2, h=(0.2 * rat * ASPECT_RATIO), w=0.2 ]
    }
    task->class_banners()

    loop {
        await :o.click.dn [me=task]
        print(G.gold >= unit_cost)
        until ((G.gold >= unit_cost) && (#G.party < 10))
    }
    
    pico.output.sound(SOUNDS.pop)
    
    set G.party = G.party ++ [char]
    emit @(2) (:card_bought)
    
    set G.gold = (G.gold - unit_cost)
    emit @(2) (:gold_spent)

    pub.id
}

val func roll () {
    ;; TODO: port tier_weights / weighted_pick from the Lua roll logic
    return [
        :swordsman,
        :wizard,
        :swordsman,
    ]
}

;; PATTERN #4 : Lifespan Hierarchies : Shop > Widgets (go,roll,cards,party)
;;  - Shop owns all widgets which nest complex behavior, safely aborting them
;;    on termination, regardless of their state.
;; PATTERN #7 : Dynamic Collections : TODO

val task Shop () {
    spawn Button(:go, 2, rect, "Go!") where {
        rect = ['%', x=0.88, y=0.9, h=0.1]
    }
    
    spawn {
        loop {
            val runs = parse_rich_text("shop - gold: [gold]" ++ G.gold)
            val positions, totalWidth = measure_runs(runs, 0.04 * (1 - PAD))

            watching :gold_spent {
                loop on :draw {
                    loop i, run in runs {
                        val pos = positions@i

                        pico.set.pencil [ color=run.color ]
                        pico.output.draw.text(run.text, [
                            '%',
                            x = 0.03 + pos.start,
                            y = 0.06,
                            h = 0.04 * (1 - PAD),
                            anchor = "W"
                        ])
                    }
                }
            }
        }
    }

    ;; TODO: incomplete
    spawn {
        par {
            loop {
                spawn RichTextButton(:roll, 1, rct, lbl) where {
                    rct = ['%', x=0.34, y=0.06, h=0.04]
                    lbl = "[idle]Rerolls: [gold]" ++ G.rolls
                }

                pin cs = tasks()
                loop i, char in roll() {
                    spawn @cs Card(i, char)
                }

                await :o.click.dn [id=:roll] until ((G.rolls > 0) && (G.gold >= 2))
                set G.rolls = (G.rolls - 1)
                
                set G.gold = (G.gold - 2)
                emit (:gold_spent)
            }
        } with {
            loop {
                pin ps = tasks()
                loop i, char in G.party {
                    spawn @ps Party_Cell(i, char)
                }
                await(:card_bought)
            }
        }
    }

    par:any {
        await :o.click.dn [id=:go]
        true    ;; Go!
    } with {
        await :key.dn [key=:Escape]
        false   ;; ESC
    }
}

Shop
