val Shop   = require "arena.shop"
val Battle = require "arena.battle"

;; PATTERN #2 : Continuation Passing : battle loop
;;  - completion of long-lasting Shop activates Battle
;;  - completion of Battle re-activates the Shop in a loop

task () {
    var ok = await Shop()
    loop {
        while(ok)

        val msg = "level " ++ G.level ++ "/" ++ MAX_LEVEL
        val survived = await Transition(msg, [x=0.9,y=0.9], Battle)

        ;; survivors carry their party into the next level, a wipe (or a
        ;; finished run) starts over from level 1
        if survived && (G.level < MAX_LEVEL) {
            ;; paid for the level just cleared, so the shop ahead has it
            set G.gold = (G.gold + level_reward(G.level))
            set G.level = (G.level + 1)
        } else {
            set G = new_run()
        }

        set ok = await Transition("..", [x=0.5,y=0.5], Shop)
    }
}
