;; snake units now pull snake position from shared.atm 

val task Swordsman(unit_pos, enemy_pos) {
    print("swordsman_ability")
    
    val SWORDSMAN_DMG = 10
    val SWORDSMAN_KNOCKBACK = 0.08

    ;; TODO: rotation of hit area (layers?)

    val AREA_SIZE = 0.1
    val hit_area_rect = [ "%",
        x = enemy_pos.x,
        y = enemy_pos.y,
        w = AREA_SIZE,
        h = (AREA_SIZE * ASPECT_RATIO),
    ]

    ;; area_drawing
    spawn {
        loop on :draw {
            pico.set.pencil [ color=COLORS.gold ]
            pico.output.draw.rect(hit_area_rect)
        }
    }
    
    ;; hit detection
    loop t, _ in ENEMIES {
        if pico.vs.pos.rect([ "%",  x=t.pub.x, y=t.pub.y ], hit_area_rect) {
            emit @t :damaged [ dmg=SWORDSMAN_DMG ]
            emit @t :on_collided [ srcX=unit_pos.x, srcY=unit_pos.y, knockback=SWORDSMAN_KNOCKBACK ]
        }
    }

    await(0.3 * 1s)
}

val task Wizard(unit_pos, enemy_pos) {
    print("wizard_ability")
    
    await(false)
}

[
    swordsman = [ caster = Swordsman, interval = 2 * 1s ],
    wizard = [ caster = Wizard, interval = 5 * 1s ]
]

