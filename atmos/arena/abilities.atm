;; snake units now pull snake position from shared.atm 

val func rand_between(lo, hi) { (lo + (math.random() * (hi - lo))) }

;; the first enemy within radius of a point, or nil. Enemies do not look
;; for friendly shots, so a shot has to do the looking itself
val func enemy_hit(px, py, radius) {
    loop _, t in ENEMIES {
        val dx = (t.pub.x - px)
        val dy = ((t.pub.y - py) / ASPECT_RATIO)
        until (math.sqrt((dx*dx) + (dy*dy)) < radius, t)
    }
}

;; a cast's hit area, drawn from the battle's effects pool rather than from
;; under the caster. FX sits above the enemies pool in the tree, so the area
;; is painted before the seekers and they stay visible on top of it
;;
;; 102/255 is 40% opaque: the area tints what is under it without hiding it
val ABILITY_FX = 0.3 * 1s
val func hit_alpha (color) { pico.color.alpha(color, 102) }

val task Hit_Area (rect, color) {
    pin spring = spawn Spring.Simple(0.8)
    emit @spring :start
    watching (ABILITY_FX) {
        loop on :draw {
            pico.set.pencil [ color=color ]
            pico.output.draw.rect([ "%",
                x = rect.x,
                y = rect.y,
                w = (rect.w * spring.pub.scale),
                h = (rect.h * spring.pub.scale),
            ])
        }
    }
}

val task Swordsman(unit_pos, enemy_pos) {
    print("swordsman_ability")
    
    ;; TODO: rotation of hit area (layers?)
    val AREA_SIZE = 0.14   ;; bigger than wizard's
    val hit_area_rect = [ "%",
        x = unit_pos.x,
        y = unit_pos.y,
        w = AREA_SIZE,
        h = (AREA_SIZE * ASPECT_RATIO),
    ]

    spawn @FX Hit_Area(hit_area_rect, hit_alpha(COLORS.yellow.base))
    
    pico.output.sound(CHARACTERS@('swordsman').sound)
    
    val SWORDSMAN_DMG = 10
    val SWORDSMAN_KNOCKBACK = 0.08
    ;; hit detection
    loop _, t in ENEMIES {
        if pico.vs.pos.rect([ "%",  x=t.pub.x, y=t.pub.y ], hit_area_rect) {
            emit @t :hit [
                dmg=SWORDSMAN_DMG,
                srcX=unit_pos.x, srcY=unit_pos.y,
                knockback=SWORDSMAN_KNOCKBACK,
            ]
        }
    }
    
    await(0.3 * 1s)
}

val task Wizard(unit_pos, enemy_pos) {
    print("wizard_ability")
    
    val WIZARD_DMG = 10
    val WIZARD_KNOCKBACK = 0.08
    ;; TODO: rotation of hit area (layers?)
    val AREA_SIZE = 0.1
    val hit_area_rect = [ "%",
        x = enemy_pos.x,
        y = enemy_pos.y,
        w = AREA_SIZE,
        h = (AREA_SIZE * ASPECT_RATIO),
    ]
    
    spawn @FX Hit_Area(hit_area_rect, hit_alpha(COLORS.blue.base))
    
    pico.output.sound(CHARACTERS@('wizard').sound)

    ;; hit detection
    loop _, t in ENEMIES {
        if pico.vs.pos.rect([ "%",  x=t.pub.x, y=t.pub.y ], hit_area_rect) {
            emit @t :hit [
                dmg=WIZARD_DMG,
                srcX=unit_pos.x, srcY=unit_pos.y,
                knockback=WIZARD_KNOCKBACK,
            ]
        }
    }
    await(0.3 * 1s)
}


val TURRET_SIZE = 0.024
val TURRET_GAP_LO = 2750ms      ;; SNKRX fires its sentry every {2.75, 3.5}
val TURRET_GAP_HI = 3500ms
val TURRET_SHOTS = 4            ;; four bullets, square to each other

val SHOT_SIZE = 0.01
val SHOT_SPEED = 0.35
val SHOT_LIFE = 2s
val SHOT_DMG = 8
val SHOT_KNOCKBACK = 0.04
val SHOT_HIT_R = 0.02

;; PATTERN #7 : Dynamic Collections : a bullet outlives the turret's volley
;;  - it leaves on its own heading and ends on whichever comes first: an
;;    enemy, a wall, or its own age
val task Turret_Shot (startX, startY, r) {
    var px, py = (startX, startY)

    spawn {
        loop on :draw {
            pico.set.pencil [ color=oval_clr(COLORS.green.base) ]
            pico.output.draw.oval([ "%",
                x=px, y=py, w=SHOT_SIZE, h=(SHOT_SIZE * ASPECT_RATIO),
            ])
        }
    }

    par :any {
        ;; travelling, until it leaves the arena
        loop us on :clock {
            val dt = us/1s
            set px = (px + (math.cos(r) * SHOT_SPEED * dt))
            set py = (py + (math.sin(r) * SHOT_SPEED * dt * ASPECT_RATIO))
            until ((px < ARENA_LEFT) || (px > ARENA_RIGHT) ||
                   (py < ARENA_TOP) || (py > ARENA_BOTTOM))
        }
    } with {
        ;; the first enemy it reaches takes it, and the shot is spent
        val t = loop on :clock {
            until (enemy_hit(px, py, SHOT_HIT_R))
        }
        emit @t :hit [
            dmg=SHOT_DMG, srcX=px, srcY=py, knockback=SHOT_KNOCKBACK,
        ]
    } with {
        await(SHOT_LIFE)
    }
}

;; PATTERN #4 : Lifespan Hierarchies : Battle > turrets
;;  - spawned into the battle's pool rather than under the unit that built
;;    it, so it keeps firing after the cast ends and after its builder dies
val task Turret (x, y) {
    spawn {
        loop on :draw {
            pico.set.pencil [ color=oval_clr(COLORS.green.base) ]
            pico.output.draw.oval([ "%",
                x=x, y=y, w=TURRET_SIZE, h=(TURRET_SIZE * ASPECT_RATIO),
            ])
        }
    }

    ;; fires on its own clock whether or not anything is in front of it,
    ;; four bullets square to each other, off a fresh heading each volley
    loop {
        await(rand_between(TURRET_GAP_LO, TURRET_GAP_HI))
        val base = (math.random() * 2 * math.pi)
        loop k in TURRET_SHOTS {
            ;; into the battle's pool, so a volley is not tied to the turret
            spawn @TURRETS Turret_Shot(x, y, (base + ((k - 1) * (math.pi/2))))
        }
    }
}

;; the cast is over in a moment, but what it leaves behind is not
val task Sentry (unit_pos, enemy_pos, party) {
    print("sentry_ability")
    spawn @TURRETS Turret(unit_pos.x, unit_pos.y)
    pico.output.sound(CHARACTERS@('sentry').sound)
    await(0.3 * 1s)
}

val PRIEST_HEAL = 0.2       ;; a fifth of each unit's maximum
val PRIEST_SIZE = 0.16

;; PATTERN #5 : Signaling Mechanisms : Priest -> party pool
;;  - the only ability that reaches the party rather than the enemies. It
;;    is addressed at the pool the units sit in, so it needs no reference
;;    to any one of them, and each unit decides what the heal means to it
val task Priest (unit_pos, enemy_pos, party) {
    print("priest_ability")
    emit @party :heal [ frac=PRIEST_HEAL ]
    pico.output.sound(CHARACTERS@('priest').sound)

    spawn @FX Hit_Area([ "%",
        x = unit_pos.x, y = unit_pos.y,
        w = PRIEST_SIZE, h = (PRIEST_SIZE * ASPECT_RATIO),
    ], hit_alpha(COLORS.green.base))

    await(0.3 * 1s)
}

;; needs_target says whether the unit has to see an enemy before it fires.
;; the priest is the first that does not, which is why the flag exists
[
    swordsman = [ caster = Swordsman, interval = 2 * 1s, range = 0.08, needs_target = true ],
    wizard = [ caster = Wizard, interval = 5 * 1s, range = 0.13, needs_target = true ],
    sentry = [ caster = Sentry, interval = 7 * 1s, range = 0.13, needs_target = true ],
    priest = [ caster = Priest, interval = 12 * 1s, range = 0, needs_target = false ]
]

