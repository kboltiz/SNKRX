val SEEKER_SPEED = 0.15
val SEEKER_SIZE = 0.025
val SEEKER_TURN_RATE = 3
val SEEKER_HEALTH = 20

;; seeker is the most basic type of enemy
;; bosses will build on top of this seeker behavior

val task Seeker(startX, startY) {
    ;; health can be made public, but no
    ;; strong reason to do that yet
    var health = SEEKER_HEALTH
    set pub = [ x=startX, y=startY, r=0 ]

    ;; add to enemy pool
    set ENEMIES@(task) = true

    spawn {
        loop {
            val us = await :clock
            val dt = us/1s
            val dx = (SNAKE_POS.x - pub.x)
            val dy = ((SNAKE_POS.y - pub.y) / ASPECT_RATIO)
            val desired = math.atan(dy, dx)

            val diff = angle_diff(pub.r, desired)
            val maxTurn = (SEEKER_TURN_RATE * dt)
            val turn = math.max(math.min(diff, maxTurn), -maxTurn)
            set pub.r = (pub.r + turn)
            set pub.x = (pub.x + (math.cos(pub.r) * SEEKER_SPEED * dt))
            set pub.y = (pub.y + (math.sin(pub.r) * SEEKER_SPEED * dt * ASPECT_RATIO))
        }
    }

    spawn {
        loop on :draw {
            pico.set.pencil [ color=:red ]
            pico.output.draw.oval([ "%",
                x=pub.x, y=pub.y,
                w=SEEKER_SIZE, h=(SEEKER_SIZE * ASPECT_RATIO),
                r=pub.r,
            ])
        }
    }

    ;; collision detection done by snake units
    spawn {
    	;; TODO: maintain velocity var and then "push" away
        loop e on :on_collided {
            val ang = math.atan(
                ((pub.y - e.srcY) / ASPECT_RATIO),
                (pub.x - e.srcX)
            )
            set pub.x = (pub.x + (math.cos(ang) * e.knockback))
            set pub.y = (pub.y + (math.sin(ang) * e.knockback * ASPECT_RATIO))
        }
    }

    loop e on :damaged until (health <= 0) {
        set health = (health - e.dmg)
    }

    ;; remove enemy from pool
    set ENEMIES@(task) = nil
}
Seeker
