val SEEKER_SPEED = 0.15
val SEEKER_SIZE = 0.025
val SEEKER_TURN_RATE = 3
val SEEKER_HEALTH = 20

;; steering, ported from SNKRX: seekers chase, drift, and push off each other,
;; which is what turns a spawned clump into a swarm instead of a rigid block
val SEPARATION_DIST = SEEKER_SIZE   ;; a body width, SNKRX separates at 16px
val SEPARATION_WEIGHT = 1.5         ;; how hard neighbours push against the chase
val WANDER_RATE = 3                 ;; how fast the drift wanders, in rad/s
val WANDER_MAX = 0.6                ;; how far it can pull off the chase

;; the arena walls are solid: pull a seeker back inside and report which of
;; them it ran into, so a knockback can bounce off instead of pressing through
val func clamp_to_arena(pos) {
    var hitV, hitH = (false, false)
    if pos.x < ARENA_LEFT {
        set pos.x = ARENA_LEFT
        set hitV = true
    }
    if pos.x > ARENA_RIGHT {
        set pos.x = ARENA_RIGHT
        set hitV = true
    }
    if pos.y < ARENA_TOP {
        set pos.y = ARENA_TOP
        set hitH = true
    }
    if pos.y > ARENA_BOTTOM {
        set pos.y = ARENA_BOTTOM
        set hitH = true
    }
    return(hitV, hitH)
}

;; sum of the pushes away from every neighbour that is too close, each one
;; stronger the nearer it is (self scores 0 distance and is skipped)
val func separation(pos) {
    var sx, sy = (0, 0)
    loop _, t in ENEMIES {
        val dx = (pos.x - t.pub.x)
        val dy = ((pos.y - t.pub.y) / ASPECT_RATIO)
        val d = math.sqrt((dx*dx) + (dy*dy))
        if (d > 0) && (d < SEPARATION_DIST) {
            val push = ((SEPARATION_DIST - d) / SEPARATION_DIST)
            set sx = (sx + ((dx / d) * push))
            set sy = (sy + ((dy / d) * push))
        }
    }
    return(sx, sy)
}

;; how far the snake is, in x-units
val func snake_dist(pos) {
    val dx = (SNAKE_POS.x - pos.x)
    val dy = ((SNAKE_POS.y - pos.y) / ASPECT_RATIO)
    return(math.sqrt((dx*dx) + (dy*dy)))
}

val func snake_angle(pos) {
    return(math.atan(((SNAKE_POS.y - pos.y) / ASPECT_RATIO), (SNAKE_POS.x - pos.x)))
}

;; one tick of the chase: turn towards the snake, pushed off the neighbours
;; and nudged by this one's own drift, then step forward
val func seek_step(pos, drift, dt, speed) {
    val chase = snake_angle(pos)

    val wander = math.max(math.min(
        (drift + (((math.random() - 0.5) * 2) * WANDER_RATE * dt)),
        WANDER_MAX), -WANDER_MAX)

    val sx, sy = separation(pos)
    val desired = math.atan(
        (math.sin(chase) + (sy * SEPARATION_WEIGHT)),
        (math.cos(chase) + (sx * SEPARATION_WEIGHT))
    ) + wander

    val diff = angle_diff(pos.r, desired)
    val maxTurn = (SEEKER_TURN_RATE * dt)
    val turn = math.max(math.min(diff, maxTurn), -maxTurn)
    set pos.r = (pos.r + turn)
    set pos.x = (pos.x + (math.cos(pos.r) * speed * dt))
    set pos.y = (pos.y + (math.sin(pos.r) * speed * dt * ASPECT_RATIO))

    ;; no reflection while seeking: it is already steering back towards the
    ;; snake, which is inside the arena
    clamp_to_arena(pos)

    return(wander)
}

;; slows by this much per second, ending up ~e.knockback from where it was hit
;; PATTERN #1 : Finite State Machines : base -> white -> base
;;  - the same shape the snake's units use: the hit whitens whatever is
;;    drawing, and the drawing side never asks whether it was hit
val HIT_FLASH = 100ms

;; runs alongside whatever else reacts to :hit, and only says what colour
;; the thing should be drawn in
val task Flash (state, base) {
    loop {
        await :hit
        set state.clr = :white
        await(HIT_FLASH)
        set state.clr = base
    }
}

val KNOCKBACK_DECAY = 14
val KNOCKBACK_STOP = 0.005

;; the chase as a task of its own, so an attack can switch it off and back on
;; instead of each phase restating it. The wander lives in here: toggling
;; suspends the task rather than dropping it, so what it has accumulated
;; survives an interruption and no caller has to hold it on its behalf
val task Chase(pos, speed) {
    var drift = 0
    loop us on :clock {
        set drift = seek_step(pos, drift, us/1s, speed)
    }
}

;; seeker is the most basic type of enemy
;; bosses will build on top of this seeker behavior

val task Seeker(startX, startY) {
    ;; health can be made public, but no
    ;; strong reason to do that yet
    var health = SEEKER_HEALTH
    set pub = [ x=startX, y=startY, r=0 ]

    ;; its own chase, so identical seekers do not travel identical paths
    pin chase = spawn Chase(pub, SEEKER_SPEED)

    val look = [ clr = :red ]
    spawn Flash(look, :red)

    spawn {
        loop {
            val e = await :hit
            ;; suspended, not dropped: the wander it built up is still
            ;; there when the knockback finishes
            toggle chase(false)

            ;; knocked back, sliding away from the hit until it stops
            val ang = math.atan(
                ((pub.y - e.srcY) / ASPECT_RATIO),
                (pub.x - e.srcX)
            )
            var slide = ang
            var speed = (e.knockback * KNOCKBACK_DECAY)
            loop {
                val us = await :clock
                val dt = us/1s
                set pub.x = (pub.x + (math.cos(slide) * speed * dt))
                set pub.y = (pub.y + (math.sin(slide) * speed * dt * ASPECT_RATIO))

                ;; shoved into a wall: bounce off it and keep sliding
                val hitV, hitH = clamp_to_arena(pub)
                if hitV {
                    set slide = (math.pi - slide)
                }
                if hitH {
                    set slide = -slide
                }

                set speed = (speed - (speed * KNOCKBACK_DECAY * dt))
                until (speed < KNOCKBACK_STOP)
            }

            toggle chase(true)
        }
    }

    spawn {
        loop on :draw {
            pico.set.pencil [ color=look.clr ]
            pico.output.draw.oval([ "%",
                x=pub.x, y=pub.y,
                w=SEEKER_SIZE, h=(SEEKER_SIZE * ASPECT_RATIO),
                r=pub.r,
            ])
        }
    }

    ;; same event as the knockback above: a hit carries both what it deals
    ;; and where it came from
    loop e on :hit {
        set health = (health - e.dmg)
        until (health <= 0)
    }
}

;; headbutter, the first mini-boss: it chases like a seeker, but once it gets
;; close it plants itself, winds up in plain sight, and rams
;; values ported from SNKRX: 76px range, 2s wind-up, 0.75s charge, 10s between
val HEADBUTT_RANGE = 0.12
val HEADBUTT_WINDUP = 2s
val HEADBUTT_CHARGE = 750ms
val HEADBUTT_COOLDOWN = 10s
val HEADBUTT_SPEED = (SEEKER_SPEED * 4.5)   ;; a ram, not a walk
val HEADBUTT_AIM_RATE = 1.5                 ;; slow enough to be dodged

val HEADBUTTER_HEALTH = 120
val HEADBUTTER_W = 0.0375                   ;; the 18x7 rectangle SNKRX draws
val HEADBUTTER_H = 0.026

;; turn towards the snake at a fixed rate, without moving
val func aim_step(pos, dt, rate) {
    val diff = angle_diff(pos.r, snake_angle(pos))
    val maxTurn = (rate * dt)
    set pos.r = (pos.r + math.max(math.min(diff, maxTurn), -maxTurn))
}

;; PATTERN #1 : Finite State Machines : chase -> wind up -> ram -> recover
;;  - each phase is a plain sequential await, so the state is the line the
;;    task is sitting on rather than a flag to be tested
val task Headbutter(startX, startY) {
    var health = HEADBUTTER_HEALTH
    set pub = [ x=startX, y=startY, r=0 ]

    var windup = 0      ;; 0..1 while winding up, 0 the rest of the time

    val look = [ clr = nil ]    ;; set only while the flash is up
    spawn Flash(look, nil)

    ;; the chase is what it does by default: the attack below switches it off
    ;; while the ram lands, rather than restating it either side
    pin chase = spawn Chase(pub, SEEKER_SPEED)

    spawn {
        loop {
            ;; close enough to be worth ramming
            loop on :clock {
                until (snake_dist(pub) <= HEADBUTT_RANGE)
            }
            toggle chase(false)

            ;; plant and turn to face the snake, telegraphing the whole time
            watching (HEADBUTT_WINDUP) {
                loop us on :clock {
                    val dt = us/1s
                    set windup = math.min((windup + (dt / (HEADBUTT_WINDUP/1s))), 1)
                    aim_step(pub, dt, HEADBUTT_AIM_RATE)
                }
            }
            set windup = 0

            ;; commit: the ram holds its heading, so it can be side-stepped
            val ram = pub.r
            watching (HEADBUTT_CHARGE) {
                loop us on :clock {
                    val dt = us/1s
                    set pub.x = (pub.x + (math.cos(ram) * HEADBUTT_SPEED * dt))
                    set pub.y = (pub.y + (math.sin(ram) * HEADBUTT_SPEED * dt * ASPECT_RATIO))
                    val hitV, hitH = clamp_to_arena(pub)
                    ;; a wall ends the charge early
                    until (hitV || hitH)
                }
            }

            ;; back to chasing while it recovers
            toggle chase(true)
            await(HEADBUTT_COOLDOWN)
        }
    }

    spawn {
        loop on :draw {
            ;; a hit whitens it outright, otherwise it whitens as the
            ;; wind-up completes, so the ram stays readable
            pico.set.pencil [ color=(look.clr || ['%',
                r = (COLORS.orange.base.r + ((1 - COLORS.orange.base.r) * windup)),
                g = (COLORS.orange.base.g + ((1 - COLORS.orange.base.g) * windup)),
                b = (COLORS.orange.base.b + ((1 - COLORS.orange.base.b) * windup)),
            ]) ]
            pico.output.draw.rect([ "%",
                x=pub.x, y=pub.y,
                w=HEADBUTTER_W, h=(HEADBUTTER_H * ASPECT_RATIO),
                r=pub.r,
            ])
        }
    }

    ;; no knockback phase: a boss shrugs off the shove and only takes the damage
    loop e on :hit {
        set health = (health - e.dmg)
        until (health <= 0)
    }
}

;; PATTERN #7 : Dynamic Collections : shots outlive whoever fired them
;;  - spawned into a pool owned by the battle, not by the shooter, so killing
;;    the shooter leaves its shots in the air
;;  - it carries the values it was fired with: nothing here reads the shooter
val PROJECTILE_SPEED = 0.29     ;; SNKRX fires at 140px/s across a 480 wide world
val PROJECTILE_W = 0.0208       ;; its 10x4 rectangle, half the boss
val PROJECTILE_H = 0.0148
val PROJECTILE_LIFE = 6s        ;; a stray shot cannot linger forever

val task Projectile(startX, startY, r, dmg) {
    set pub = [ x=startX, y=startY, r=r, dmg=dmg ]

    spawn {
        loop on :draw {
            pico.set.pencil [ color=COLORS.fg.base ]
            pico.output.draw.rect([ "%",
                x=pub.x, y=pub.y,
                w=PROJECTILE_W, h=(PROJECTILE_H * ASPECT_RATIO),
                r=pub.r,
            ])
        }
    }

    ;; whichever comes first: a wall, a unit soaking it up, or old age
    par :any {
        loop us on :clock {
            val dt = us/1s
            set pub.x = (pub.x + (math.cos(pub.r) * PROJECTILE_SPEED * dt))
            set pub.y = (pub.y + (math.sin(pub.r) * PROJECTILE_SPEED * dt * ASPECT_RATIO))
            val hitV, hitH = clamp_to_arena(pub)
            until (hitV || hitH)
        }
    } with {
        await :absorbed
    } with {
        await(PROJECTILE_LIFE)
    }
}

;; shooter, the second mini-boss: it chases only until it settles, then it is
;; a turret that tracks the snake and fires bursts at it
;; ported from SNKRX: settles after 2-4s, bursts of 3 about 0.15s apart,
;; every 4-6s, and it never moves again once planted
val SHOOTER_SETTLE = 3s
val SHOOTER_BURST_GAP = 5s
val SHOOTER_SHOTS = 3
val SHOOTER_SHOT_GAP = 150ms
val SHOOTER_AIM_RATE = 1.2      ;; slow tracking, so strafing beats it
val SHOOTER_DMG = 10

val SHOOTER_HEALTH = 120
val SHOOTER_W = 0.0375                      ;; same 18x7 boss rectangle
val SHOOTER_H = 0.026

val task Shooter(startX, startY, shots) {
    var health = SHOOTER_HEALTH
    set pub = [ x=startX, y=startY, r=0 ]

    val look = [ clr = COLORS.fg.base ]
    spawn Flash(look, COLORS.fg.base)

    spawn {
        ;; walks in with the clump, then plants itself for good
        par :any {
            await(SHOOTER_SETTLE)
        } with {
            await Chase(pub, SEEKER_SPEED)
        }

        ;; tracking runs on its own from here, so it keeps aiming between bursts
        spawn {
            loop us on :clock {
                aim_step(pub, us/1s, SHOOTER_AIM_RATE)
            }
        }

        loop {
            await(SHOOTER_BURST_GAP)
            loop _ in SHOOTER_SHOTS {
                ;; into the battle's pool: this outlives the shooter
                spawn @shots Projectile(pub.x, pub.y, pub.r, SHOOTER_DMG)
                await(SHOOTER_SHOT_GAP)
            }
        }
    }

    spawn {
        loop on :draw {
            pico.set.pencil [ color=look.clr ]
            pico.output.draw.rect([ "%",
                x=pub.x, y=pub.y,
                w=SHOOTER_W, h=(SHOOTER_H * ASPECT_RATIO),
                r=pub.r,
            ])
        }
    }

    loop e on :hit {
        set health = (health - e.dmg)
        until (health <= 0)
    }
}

[ seeker = Seeker, headbutter = Headbutter, shooter = Shooter ]
