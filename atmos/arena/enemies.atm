val SEEKER_SPEED = 0.15
val SEEKER_SIZE = 0.025
val SEEKER_TURN_RATE = 3
val SEEKER_HEALTH = 20

;; steering, ported from SNKRX: seekers chase, drift, and push off each other,
;; which is what turns a spawned clump into a swarm instead of a rigid block
val SEPARATION_DIST = SEEKER_SIZE   ;; a body width, SNKRX separates at 16px
val SEPARATION_WEIGHT = 1.5         ;; how hard neighbours push against the chase
val WANDER_RATE = 3                 ;; how fast the drift wanders, in rad/s
val WANDER_MAX = 0.6                ;; how far it can pull off the chase

;; the arena walls are solid: pull a seeker back inside and report which of
;; them it ran into, so a knockback can bounce off instead of pressing through
val func clamp_to_arena(pos) {
    var hitV, hitH = (false, false)
    if pos.x < ARENA_LEFT {
        set pos.x = ARENA_LEFT
        set hitV = true
    }
    if pos.x > ARENA_RIGHT {
        set pos.x = ARENA_RIGHT
        set hitV = true
    }
    if pos.y < ARENA_TOP {
        set pos.y = ARENA_TOP
        set hitH = true
    }
    if pos.y > ARENA_BOTTOM {
        set pos.y = ARENA_BOTTOM
        set hitH = true
    }
    return(hitV, hitH)
}

;; sum of the pushes away from every neighbour that is too close, each one
;; stronger the nearer it is (self scores 0 distance and is skipped)
val func separation(pos) {
    var sx, sy = (0, 0)
    loop _, t in ENEMIES {
        val dx = (pos.x - t.pub.x)
        val dy = ((pos.y - t.pub.y) / ASPECT_RATIO)
        val d = math.sqrt((dx*dx) + (dy*dy))
        if (d > 0) && (d < SEPARATION_DIST) {
            val push = ((SEPARATION_DIST - d) / SEPARATION_DIST)
            set sx = (sx + ((dx / d) * push))
            set sy = (sy + ((dy / d) * push))
        }
    }
    return(sx, sy)
}

;; how far the snake is, in x-units
val func snake_dist(pos) {
    val dx = (SNAKE_POS.x - pos.x)
    val dy = ((SNAKE_POS.y - pos.y) / ASPECT_RATIO)
    return(math.sqrt((dx*dx) + (dy*dy)))
}

val func snake_angle(pos) {
    return(math.atan(((SNAKE_POS.y - pos.y) / ASPECT_RATIO), (SNAKE_POS.x - pos.x)))
}

;; one tick of the chase: turn towards the snake, pushed off the neighbours
;; and nudged by this one's own drift, then step forward
val func seek_step(pos, drift, dt, speed) {
    val chase = snake_angle(pos)

    set drift.n = math.max(math.min(
        (drift.n + (((math.random() - 0.5) * 2) * WANDER_RATE * dt)),
        WANDER_MAX), -WANDER_MAX)

    val sx, sy = separation(pos)
    val desired = math.atan(
        (math.sin(chase) + (sy * SEPARATION_WEIGHT)),
        (math.cos(chase) + (sx * SEPARATION_WEIGHT))
    ) + drift.n

    val diff = angle_diff(pos.r, desired)
    val maxTurn = (SEEKER_TURN_RATE * dt)
    val turn = math.max(math.min(diff, maxTurn), -maxTurn)
    set pos.r = (pos.r + turn)
    set pos.x = (pos.x + (math.cos(pos.r) * speed * dt))
    set pos.y = (pos.y + (math.sin(pos.r) * speed * dt * ASPECT_RATIO))

    ;; no reflection while seeking: it is already steering back towards the
    ;; snake, which is inside the arena
    clamp_to_arena(pos)
}

;; slows by this much per second, ending up ~e.knockback from where it was hit
val KNOCKBACK_DECAY = 14
val KNOCKBACK_STOP = 0.005

;; seeker is the most basic type of enemy
;; bosses will build on top of this seeker behavior

val task Seeker(startX, startY) {
    ;; health can be made public, but no
    ;; strong reason to do that yet
    var health = SEEKER_HEALTH
    set pub = [ x=startX, y=startY, r=0 ]

    ;; its own drift, so identical seekers do not travel identical paths
    val drift = [ n=0 ]

    spawn {
        loop {
            ;; seeking
            val e = watching :hit {
                loop us on :clock {
                    seek_step(pub, drift, us/1s, SEEKER_SPEED)
                }
            }

            ;; knocked back, sliding away from the hit until it stops
            val ang = math.atan(
                ((pub.y - e.srcY) / ASPECT_RATIO),
                (pub.x - e.srcX)
            )
            var slide = ang
            var speed = (e.knockback * KNOCKBACK_DECAY)
            loop {
                val us = await :clock
                val dt = us/1s
                set pub.x = (pub.x + (math.cos(slide) * speed * dt))
                set pub.y = (pub.y + (math.sin(slide) * speed * dt * ASPECT_RATIO))

                ;; shoved into a wall: bounce off it and keep sliding
                val hitV, hitH = clamp_to_arena(pub)
                if hitV {
                    set slide = (math.pi - slide)
                }
                if hitH {
                    set slide = -slide
                }

                set speed = (speed - (speed * KNOCKBACK_DECAY * dt))
                until (speed < KNOCKBACK_STOP)
            }
        }
    }

    spawn {
        loop on :draw {
            pico.set.pencil [ color=:red ]
            pico.output.draw.oval([ "%",
                x=pub.x, y=pub.y,
                w=SEEKER_SIZE, h=(SEEKER_SIZE * ASPECT_RATIO),
                r=pub.r,
            ])
        }
    }

    ;; same event as the knockback above: a hit carries both what it deals
    ;; and where it came from
    loop e on :hit {
        set health = (health - e.dmg)
        until (health <= 0)
    }
}
Seeker
