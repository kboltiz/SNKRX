set W = 640
set H = 360
set ASPECT_RATIO = W/H

;; last level of a run
set MAX_LEVEL = 25

;; a run's whole state, rebuilt on a wipe so a fresh start lives in one
;; place instead of being undone field by field
func new_run () {
    return [
        level = 1,
        gold  = 3,
        rolls = 3,
        ;; a run opens with an empty party and 3 gold, as SNKRX does: the
        ;; first shop is where the snake is assembled
        party = [],
        cost  = [
            swordsman = 1,
            wizard    = 1,
            sentry    = 2,
            priest    = 4,
        ],
    ]
}

set G = new_run()

;; gold paid for clearing a level, ported from SNKRX's level_to_gold_gained.
;; each entry is the [min,max] the reward is rolled between
set LEVEL_GOLD = [
    [3,3],   [3,3],   [5,6],   [4,5],   [5,8],
    [8,10],  [8,10],  [12,14], [14,18], [10,13],
    [12,15], [18,20], [10,14], [12,16], [14,18],
    [12,12], [12,12], [20,24], [8,12],  [10,14],
    [20,28], [32,32], [36,36], [48,48], [100,100],
]

;; the level's roll plus interest, which SNKRX pays at 1 per 5 gold held,
;; capped at 5. The merchant bonus and picked-up gold are not ported
func level_reward (level) {
    val band = LEVEL_GOLD@(math.min(level, #LEVEL_GOLD))
    val gained = math.random(band@1, band@2)
    val interest = math.min(math.floor(G.gold / 5), 5)
    ;; kept apart, since the clear screen counts them up one line at a time
    return [ gained=gained, interest=interest, total=(gained + interest) ]
}

;; arena bounds, shared by the snake (walls) and the battle (spawns)
set ARENA_W = 0.8
set ARENA_H = 0.4 * ASPECT_RATIO
set ARENA_LEFT = 0.5 - (ARENA_W / 2)
set ARENA_RIGHT = 0.5 + (ARENA_W / 2)
set ARENA_TOP = 0.5 - (ARENA_H / 2)
set ARENA_BOTTOM = 0.5 + (ARENA_H / 2)

;; arena centre, matches the trail seed in battle.atm
set SNAKE_POS = [x=0.5, y=0.5]

set SOUNDS = [
    pop = "../assets/sounds/bamboo_hit_by_lord.ogg",
    hover = "../assets/sounds/467951__benzix2__ui-button-click.ogg",
]
set FONT = "../assets/fonts/PixulBrush.ttf"
;; SNKRX draws the run's outcome and score in its fat pixel face
set FAT_FONT = "../assets/fonts/FatPixelFont.ttf"

;; pico-sdl leaves alpha blending switched OFF after an oval, tri or poly is
;; drawn with a fully opaque colour, and it stays off for the rest of the
;; process: every later translucent draw comes out opaque, however the pencil
;; reports itself. An alpha of 254 is indistinguishable on screen and keeps
;; blending on, so every oval in the port is drawn through this
func oval_clr (c) { pico.color.alpha(c, 254) }

